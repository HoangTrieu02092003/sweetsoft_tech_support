@model IEnumerable<Customer_sweetsoft_tech_support.Models.TblFaq>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<!DOCTYPE html>
<html style="font-size: 96px;">
<head>
    <title>Liên Hệ</title>
    
    <style>
        .card-container {
            padding-top: .4rem;
            padding-bottom: .5rem;
            min-width: 100%;
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            justify-content: center;
        }

        .card {
            width: 250px;
            border: 1px solid #ddd;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .card:hover {
                transform: scale(1.05);
                box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
            }

        .card-img-top {
            width: 100%;
            height: 250px;
            object-fit: cover;
        }

        .card-body {
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .card-title {
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 15px;
            min-height: 40px;
            text-align: center;
        }

        .card-text {
            font-size: 16px;
            color: #666;
            margin-bottom: 20px;
            text-align: center;
        }

        .btn-container {
            display: flex;
            justify-content: center;
        }

        .btn {
            font-size: 16px;
            padding: 10px 20px;
            color: #6a1b9a;
            border: 1px solid #6a1b9a;
            transition: background-color 0.3s ease, transform 0.2s ease;
            text-align: center;
        }

            .btn:hover {
                color: white;
                background-color: #6a1b9a;
                transform: scale(1.1);
            }

            .btn:active {
                transform: scale(1);
            }
    </style>
</head>

<body class="show">
    <div class="inner_bn">
        <img src="~/layoutuser/img/inner4.jpg" />
    </div>
    <div class="inner_main">
        <div class="rem12">
            <div class="dqwz">
                <a href="@Url.Action("Index", "Home")">Trang Chủ</a>
                /
                <a href="@Url.Action("Index", "TblFaqs")">FAQs</a>
            </div>
            <div class="zb_nr">
                <p class="faqscontent" style="font-size: .4rem;white-space: nowrap; color: #6510ad; text-align:center; padding-top: 2%;"><b>Chúng tôi có thể giúp gì được cho bạn ?</b></p>
                <div class="card-container">
                    @foreach (var item in Model)
                    {
                        <div class="card">
                            <img src="@(item.FaqThumbnail != null ? $"http://admintech.runasp.net/{item.FaqThumbnail}" : "http://admintech.runasp.net/assets/images/faqs/faq1.jpg")"
                                 alt="FAQ Thumbnail" class="card-img-top" />
                            <div class="card-body">
                                <h5 class="card-title">@item.Question</h5>
                                <p class="card-text">
                                    @item.Answer
                                </p>
                                <div class="btn-container">
                                    <a asp-action="Details" asp-route-id="@item.FaqId" class="btn btn-primary" style="font-weight: bold;">
                                        Xem <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</body>
</html>


