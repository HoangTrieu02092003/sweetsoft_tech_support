<!--Js xử lý đổi mật khẩu-->
<script>
    $(document).ready(function () {
        var activeTab = sessionStorage.getItem('activeTab');
        if (activeTab) {
            $(".inner_main .rem12 .zb_nr .zc ul li").removeClass('on');  // Xóa lớp 'on' của tất cả các tab
            $(".inner_main .rem12 .zb_nr .zc ul li").eq(activeTab).addClass('on');  // Thêm lớp 'on' cho tab đã chọn
        }
    });

    $(document).ready(function () {
        // When an <li> is clicked
        $("ul li a").click(function () {
            // Remove "on" class from all <li> elements
            $("ul li").removeClass("on");

            // Add "on" class to the clicked <li>
            $(this).parent().addClass("on");

            // Hide both tables initially
            $(".Account").hide();
            $(".Password").hide();
            $(".tableAccount").hide();
            $(".tablePassword").hide();

            // Show the corresponding table based on the clicked <li>
            if ($(this).text() === "Tài Khoản") {
                if ($(window).width() <= 800) {
                    $(".tableAccount").show();
                }
                else { $(".Account").show(); }
                
            } else if ($(this).text() === "Đổi Mật Khẩu") {
                if ($(window).width() <= 800) {
                    $(".tablePassword").show();
                }
                else { $(".Password").show(); }
            }
        });
    });
</script>
