@model Customer_sweetsoft_tech_support.Models.TblCustomer
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<!DOCTYPE html>
<html style="font-size: 95px;">
<head>
    <title>Tài Khoản</title>
    <style>
        /* Căn chỉnh và kiểu dáng cho thông báo */
        .alert {
            padding: 15px 20px;
            margin-bottom: 20px;
            border: 1px solid transparent;
            border-radius: 5px;
            font-size: 16px;
            display: flex;
            align-items: center;
            animation: fadeIn 0.5s ease-in-out;
        }

        /* Thông báo thành công */
        .alert-success {
            color: #155724;
            background-color: #d4edda;
            border-color: #c3e6cb;
        }

        .alert-success::before {
            content: '✔️';
            margin-right: 10px;
            font-size: 18px;
        }

        /* Thông báo lỗi */
        .alert-danger {
            color: #721c24;
            background-color: #f8d7da;
            border-color: #f5c6cb;
        }

        .alert-danger::before {
            content: '❌';
            margin-right: 10px;
            font-size: 18px;
        }

        /* Hiệu ứng fade-in */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        /* Nút đóng thông báo */
        .alert .close {
            margin-left: auto;
            background: none;
            border: none;
            font-size: 20px;
            font-weight: bold;
            cursor: pointer;
            color: inherit;
            line-height: 1;
        }

    </style>
</head>

