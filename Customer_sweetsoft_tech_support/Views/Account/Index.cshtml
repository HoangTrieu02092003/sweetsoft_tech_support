<!--Js xử lý đổi mật khẩu-->
<script>
    $(document).ready(function () {
        var activeTab = sessionStorage.getItem('activeTab');
        if (activeTab) {
            $(".inner_main .rem12 .zb_nr .zc ul li").removeClass('on');  // Xóa lớp 'on' của tất cả các tab
            $(".inner_main .rem12 .zb_nr .zc ul li").eq(activeTab).addClass('on');  // Thêm lớp 'on' cho tab đã chọn
        }
    });

    $(document).ready(function () {
        // Khi nhấn vào tab, lưu trạng thái thẻ li được chọn vào localStorage
        $("ul li a").click(function () {
            // Xóa class 'on' khỏi tất cả các thẻ li
            $("ul li").removeClass("on");

            // Gán class 'on' cho thẻ li hiện tại
            $(this).parent().addClass("on");

            // Lưu trạng thái thẻ li hiện tại vào localStorage
            localStorage.setItem('activeTab', $(this).text().trim());

            // Ẩn tất cả bảng
            $(".Account").hide();
            $(".Password").hide();
            $(".tableAccount").hide();
            $(".tablePassword").hide();

            //// Hiện bảng tương ứng
            if ($(this).text() === "Tài Khoản") {
                if ($(window).width() <= 800) {
                    $(".tableAccount").show();
                }
                else { $(".Account").show(); }
                
            } else if ($(this).text() === "Đổi Mật Khẩu") {
                if ($(window).width() <= 800) {
                    $(".tablePassword").show();
                }
                else { $(".Password").show(); }
            }
        });
    });

    // Khi trang được load lại, kiểm tra trạng thái thẻ li
    document.addEventListener('DOMContentLoaded', () => {
        const activeTab = localStorage.getItem('activeTab')||"Tài Khoản";
        const liElements = document.querySelectorAll('.zc ul li');
        const tables = {
            "Tài Khoản": {
                desktop: '.Account',
                mobile: '.tableAccount'
            },
            "Đổi Mật Khẩu": {
                desktop: '.Password',
                mobile: '.tablePassword'
            }
        };

        // Reset trạng thái của tất cả thẻ li và bảng
        liElements.forEach(li => li.classList.remove('on'));
        for (let key in tables) {
            document.querySelector(tables[key].desktop).style.display = 'none';
            document.querySelector(tables[key].mobile).style.display = 'none';
        }

        // Kích hoạt lại thẻ li và bảng tương ứng
        if (activeTab && tables[activeTab]) {
            const activeLi = [...liElements].find(li => li.textContent.trim() === activeTab);
            if (activeLi) activeLi.classList.add('on');
            
            if (window.innerWidth > 800) {
                document.querySelector(tables[activeTab].desktop).style.display = '';
            } else {
                document.querySelector(tables[activeTab].mobile).style.display = '';
            }
        } else {
            // Mặc định hiển thị bảng Tài Khoản
            document.querySelector('.zc ul li').classList.add('on');
            if (window.innerWidth > 800) {
                document.querySelector('.Account').style.display = '';
            } else {
                document.querySelector('.tableAccount').style.display = '';
            }
        }
    });

    // Đổi trạng thái bảng khi nhấn thẻ li
    document.querySelectorAll('.zc ul li').forEach(li => {
        li.addEventListener('click', () => {
            document.querySelectorAll('.zc ul li').forEach(li => li.classList.remove('on'));
            li.classList.add('on');

            // Hiện bảng phù hợp với kích thước màn hình
            const text = li.textContent.trim();
            for (let key in tables) {
                document.querySelector(tables[key].desktop).style.display = 'none';
                document.querySelector(tables[key].mobile).style.display = 'none';
            }

            if (tables[text]) {
if (window.innerWidth > 800) {
                    document.querySelector(tables[text].desktop).style.display = '';
                } else {
                    document.querySelector(tables[text].mobile).style.display = '';
                }
            }
        });
    });

    // hiện/ẩn Password

    //desktop
    const togglePasswords = document.querySelector('#togglePasswords');
    const passwordFields = [
        document.querySelector('#oldPassword'),
        document.querySelector('#newPassword'),
        document.querySelector('#confirmPassword')
    ];

    togglePasswords.addEventListener('change', () => {
        const type = togglePasswords.checked ? 'text' : 'password';
        passwordFields.forEach(field => field.setAttribute('type', type));
    });

    //mobile
    const togglePasswords1 = document.querySelector('#togglePasswords1');
    const passwordFields1 = [
        document.querySelector('#oldPassword1'),
        document.querySelector('#newPassword1'),
        document.querySelector('#confirmPassword1')
    ];

    togglePasswords1.addEventListener('change', () => {
        const type = togglePasswords1.checked ? 'text' : 'password';
        passwordFields1.forEach(field => field.setAttribute('type', type));
    });
</script>
