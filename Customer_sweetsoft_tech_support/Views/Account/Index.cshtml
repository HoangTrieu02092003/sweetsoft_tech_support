    //     input.prop("disabled", false);
    //     $(".tdNameCT").css("background-color", "#fff");
    //     input.focus();
    // });


    const inputs = document.querySelectorAll("input");

    inputs.forEach(input => {
    if (input.disabled) {
        const td = input.closest("td");
        if (td) {
            td.style.backgroundColor = "#F1F1F1";
        }
    }
    });

    //xử lý thay đổi input của name
    $(document).ready(function () {
    const input = $(".Name");
    const editLink = $(".editName");
    const originalValue = input.data("original");
    const currentValue = input.val();
    if (currentValue === originalValue) {
        editLink.css({ "pointer-events": "none", "color": "gray", "border-bottom": "1px dashed gray" });
    }
    input.on("input", function () {
        const currentValue = $(this).val();
        if (currentValue !== originalValue) {
            editLink.css({ "pointer-events": "auto", "color": "#6510ad", "border-bottom": "1px dashed #6510ad" });
        } else {
            editLink.css({ "pointer-events": "none", "color": "gray", "border-bottom": "1px dashed gray" });
        }
        if (currentValue == ""){
            editLink.css({ "pointer-events": "none", "color": "gray", "border-bottom": "1px dashed gray" });
        }
    });
});
    
    //xử lý thay đổi input của tên công ty
    $(document).ready(function () {
        const input = $(".NameCT");
        const editLink = $(".editNameCT");
        const originalValue = input.data("original");
        const currentValue = input.val();
        if (currentValue === originalValue) {
            editLink.css({ "pointer-events": "none", "color": "gray", "border-bottom": "1px dashed gray" });
        }
        input.on("input", function () {
            const currentValue = $(this).val();
            if (currentValue !== originalValue) {
                editLink.css({ "pointer-events": "auto", "color": "#6510ad", "border-bottom": "1px dashed #6510ad" });
            } else {
                editLink.css({ "pointer-events": "none", "color": "gray", "border-bottom": "1px dashed gray" });
            }
            if (currentValue == "") {
                editLink.css({ "pointer-events": "none", "color": "gray", "border-bottom": "1px dashed gray" });
            }

        });
    });

</script>

