@model IEnumerable<Customer_sweetsoft_tech_support.Models.TblRequestsProcessing>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<!DOCTYPE html>
<html style="font-size: 95px;">
<head>
    <title>Theo dõi yêu cầu</title>
</head>

<body class="show">
    <div class="inner_bn">
        <img src="~/layoutuser/img/inner3.jpg" />
    </div>
    <div class="inner_main">
        <div class="rem12">
            <div class="dqwz">
                <a href="@Url.Action("Index", "Home")">Trang Chủ</a>
                /
                <a href="@Url.Action("Index", "TblRequestsProcessings")">Theo Dõi Yêu Cầu</a>
            </div>

            <div class="zb_nr">
                <div class="zc fl zcc">
                    <div class="listmore" id="leftlistmore" style="border-bottom: 1px solid rgb(221, 221, 221); margin-bottom: 0px;">
                        <i class="icon-dot-3" style="display: block;"></i>
                        <i class="close" style="display: none;"></i>
                    </div>
                    <ul>
                        <li class="on">
                            <a href="javascript:void(0)">Tất cả</a>
                        </li>
                        <li>
                            <a href="javascript:void(0)">Đang xử lý</a>
                        </li>
                        <li>
                            <a href="javascript:void(0)">Hoàn thành</a>
                        </li>
                        <li>
                            <a href="javascript:void(0)">Không xử lý được</a>
                        </li>
                    </ul>
                </div>
                <script>
                    var inner_dh_kg = 0;
                    $(".inner_main .rem12 .zb_nr .zc .listmore i").click(function () {
                        if (inner_dh_kg == 0) {
                            $(".inner_main .rem12 .zb_nr .zc ul")[0].style.display = "block";
                            $(".inner_main .rem12 .zb_nr .zc .listmore")[0].style.borderBottom = '0';
                            $(".inner_main .rem12 .zb_nr .zc .listmore")[0].style.marginBottom = "-2px";
                            $(".inner_main .rem12 .zb_nr .zc .listmore .close")[0].style.display = "block";
                            $(".inner_main .rem12 .zb_nr .zc .listmore .icon-dot-3")[0].style.display = "none";
                            inner_dh_kg = 1;
                        } else {
                            $(".inner_main .rem12 .zb_nr .zc ul")[0].style.display = "none";
                            $(".inner_main .rem12 .zb_nr .zc .listmore")[0].style.borderBottom = '1px solid #ddd';
                            $(".inner_main .rem12 .zb_nr .zc .listmore")[0].style.marginBottom = "0";
                            $(".inner_main .rem12 .zb_nr .zc .listmore .close")[0].style.display = "none";
                            $(".inner_main .rem12 .zb_nr .zc .listmore .icon-dot-3")[0].style.display = "block";
                            inner_dh_kg = 0;
                        }

                    })
                </script>

                <script>
                    $(function () {
                        $('.inner_main .rem12 .zb_nr .zc ul li ul li a').click(function () {
                            $('html,body').animate({ scrollTop: ($($(this).attr('href')).offset().top - 138) }, 500);
                        });
                    });

                </script>

                <div class="yc yccc fr">
                    <form asp-action="Create" style="margin-bottom: .5rem;" method="get" asp-controller="TblSupportRequests">
                        <button type="submit" class="btn">
                            GỬI YÊU CẦU <i style="margin-left: .1rem;" class="fa-solid fa-arrow-right"></i>
                        </button>
                    </form>

                    @foreach(var item in Model)
                        {
                            <div class="container">
                                <div class="row" onclick="toggleContent(@item.ProcessId)">
                                    <i class="fas fa-chevron-down toggle-icon" data-id="@item.ProcessId"></i>
                                    <div class="main-content">
                                        <div class="main-contentt">
                                            <p><b>@item.Request.RequestTitle được gửi đi ngày @item.Request.CreatedAt.ToString("dd/MM/yyyy")</b></p>
                                            <span class="status">@(item.IsCompleted==0?"chưa hoàn thành":"Hoàn thành")</span>
                                        </div>
                                        <hr />
                                        <div class="main-contentt" style="padding-top:10px;">
                                            <p>Mã Phiếu: <b>@item.Request.RequestId</b> | Phòng ban xử lý yêu cầu: <b>@item.Department.DepartmentName</b></p>
                                            <p>@(item.ProcessedAt?.ToString("dd-MM-yyy HH:mm") ?? "-- -- --")</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="details" id="details-@item.ProcessId">
                                    <p>@item.Request.RequestDetails</p>
                                </div>
                            </div>
                        }
                    <script>
                        function filterRequests(status) {
                            const requests = document.querySelectorAll('.container');
                            requests.forEach(request => {
                                const statusSpan = request.querySelector('.status');
                                let statusText = statusSpan.textContent.trim();
                                let currentStatus = statusText === 'chưa hoàn thành' ? 0 : (statusText === 'Hoàn thành' ? 1 : 2);
                                if (status === null || currentStatus === status) {
                                    request.style.display = 'block';
                                } else {
                                    request.style.display = 'none';
                                }
                            });
                        }
                        document.querySelectorAll('.zc ul li').forEach((item, index) => {
                            item.addEventListener('click', function () {
                                document.querySelectorAll('.zc ul li').forEach(li => li.classList.remove('on'));
                                this.classList.add('on');
                                switch (index) {
                                    case 0:
                                        filterRequests(null);
                                        break;
                                    case 1:
                                        filterRequests(0);
                                        break;
                                    case 2:
                                        filterRequests(1);
                                        break;
                                    case 3:
                                        filterRequests(2);
                                        break;
                                }
                            });
                        });
                    </script>

                </div>
            </div>
        </div>
    </div>
</body>
</html>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function toggleContent(processId) { 
        const details = document.getElementById(`details-${processId}`); 
        const icon = document.querySelector(`.toggle-icon[data-id='${processId}']`);
        
        if (details.style.maxHeight === '0px' || !details.style.maxHeight) { 
            details.style.maxHeight = details.scrollHeight + 'px'; 
            details.style.padding = '0 15px';
            icon.style.transform = 'rotate(180deg)';
        } else { 
            details.style.maxHeight = '0px'; 
            details.style.padding = '0 15px'; 
            icon.style.transform = 'rotate(0deg)';
        } 
    }

</script>

