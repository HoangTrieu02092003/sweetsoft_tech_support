@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
    string color = "";
}

<!DOCTYPE html>
<html style="font-size: 95px;">
<head>
    <title>Theo dõi yêu cầu</title>
    <link href="~/css/chatbox.css" rel="stylesheet" />
    <script src="~/js/request.js"></script>
    <script src="~/js/chatbox.js"></script>
    <style>
        textarea {
            white-space: pre-wrap;
            overflow-wrap: break-word;
            overflow: hidden;
        }
        .chat-button {
            margin-bottom: .1rem;
            margin-left: .15rem;
            background: #fff;
            border: none;
            font-size : .22rem;
        }

            .chat-button.has-unread-feedback::after {
                content: "";
                position: absolute;
                right: 8px;
                width: .1rem;
                height: .1rem;
                background-color: #28a745;
                border-radius: 50%;
                border: 1px solid #fff;
                box-shadow: 0 0 2px rgba(0, 0, 0, 0.1);
            }

        .chat-container {
            display: flex;
            justify-content: center;
            width: 100%;
        }

        .chat-form {
            display: flex;
            align-items: center;
            border-top: 1px solid #ddd;
            padding: 5px;
            width: 100%;
            gap: 10px;
        }

        .chat-textarea {
            flex-grow: 1;
            max-height: 100px;
            height: 24px;
            resize: none;
            border: none;
            background-color: transparent;
            color: black;
            font-size: .17rem;
            line-height: 1.5;
            padding: 0 5px;
            overflow-y: auto;
        }

            .chat-textarea::-webkit-scrollbar {
                width: 0;
            }

            .chat-textarea:focus {
                outline: none;
            }

        .send-button {
            color: blue;
            border: none;
            border-radius: 50%;
            padding: 10px;
            font-size: 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .send-button i {
                pointer-events: none;
            }


    </style>
</head>

<body class="show">
    <div class="inner_bn">
        <img src="~/layoutuser/img/inner3.jpg" />
    </div>
    <div class="inner_main">
        <div class="rem12">
            <div class="dqwz">
                <a href="@Url.Action("Index", "Home")">Trang Chủ</a>
                /
                <a href="@Url.Action("Index", "TblRequestsProcessings")">Theo Dõi Yêu Cầu</a>
            </div>

            <div class="zb_nr">
                <div class="zc fl zcc">
                    <div class="listmore" id="listmore-toggle"  style="border-bottom: 1px solid rgb(221, 221, 221); margin-bottom: 0px;">
                        <i class="icon-dot-3" style="display: block;"></i>
                        <i class="close" style="display: none;"></i>
                    </div>
                    <ul>
                        <li class="on">
                            <a href="javascript:void(0)">Tất cả</a>
                        </li>
                        <li>
                            <a href="javascript:void(0)">Đang xử lý</a>
                        </li>
                        <li>
                            <a href="javascript:void(0)">Hoàn thành</a>
                        </li>
                        <li>
                            <a href="javascript:void(0)">Không xử lý được</a>
                        </li>
                    </ul>
                </div>
                <div class="yc yccc fr">
                    <form asp-action="Create" style="margin-bottom: .2rem;" method="get" asp-controller="TblSupportRequests">
                        <button type="submit" class="btn">
                            GỬI YÊU CẦU MỚI <i style="margin-left: .1rem;" class="fa-solid fa-arrow-right"></i>
                        </button>
                    </form>

                    @foreach(var item in Model)
                        {
                        var request = item.RequestProcessing;
                        var hasUnreadFeedback = item.HasUnreadFeedback;
                            <div class="containerrequest">
                            <div class="row" onclick="toggleContent(@request.ProcessId)">
                                <i class="fas fa-chevron-down toggle-icon" data-id="@request.ProcessId"></i>
                                    <div class="main-content">
                                        <div class="main-contentt">
                                        <p><b>@request.Request.RequestTitle được gửi đi ngày @request.Request.CreatedAt.ToString("dd/MM/yyyy")</b></p>
                                            @{
                                            color = request.IsCompleted == 0
                                                  ? "#e2ca5b"
                                                    : request.IsCompleted == 1
                                                  ? "green"
                                                  : "red";
                                            }
                                            <p class="status" style="color: @color;">
                                            @(request.IsCompleted == 0
                                                    ? "Chưa hoàn thành"
                                                : request.IsCompleted == 1
                                                    ? "Hoàn thành"
                                                    : "Không xử lý được")
                                            </p>
                                        </div>
                                        <hr />
                                        <div class="main-contentt" style="padding-top:10px;">
                                        <p>Mã Phiếu: <b>@request.Request.RequestId</b> | Phòng ban xử lý : <b>@request.Department.DepartmentName</b></p>
                                        <p>@(request.ProcessedAt?.ToString("dd-MM-yyy HH:mm") ?? "-- -- --")</p>
                                        </div>
                                    </div>
                                    <div>
                                    @if (request.IsCompleted == 0) // Điều kiện trạng thái là "Đang xử lý"
                                    {
                                        <button class="chat-button open-chat d-block @(hasUnreadFeedback ?"has-unread-feedback":"")" data-request-id="@request.RequestId" data-title="@request.Request.RequestTitle" onclick="openChat(event);">
                                            <span class="bi bi-chat-dots"></span>
                                        </button>
                                    }
                                    </div>
                                </div>
                            <div class="details" id="details-@request.ProcessId">
                                <p><strong>Câu hỏi: </strong>@request.Request.RequestDetails</p>
                                    <p><strong>----------------------------------</strong></p>
                                    <p><strong>Hỗ Trợ:</strong></p>
                                <p>@request.Note</p>
                                </div>
                            </div>
                        }

                    <script>
                        function filterRequests(status) {
                            const requests = document.querySelectorAll('.containerrequest');
                            requests.forEach(request => {
                                const statusSpan = request.querySelector('.status');
                                let statusText = statusSpan.textContent.trim();
                                if ( statusText === 'Chưa hoàn thành' ){
                                    currentStatus = 0;
                                }
                                else if ( statusText === 'Hoàn thành'){
                                    currentStatus = 1;
                                }
                                else { currentStatus = 2; }

                                if (status === null || currentStatus === status) {
                                    request.style.display = 'block';
                                } else {
                                    request.style.display = 'none';
                                }
                            });
                        }
                        document.querySelectorAll('.zc ul li').forEach((item, index) => {
                            item.addEventListener('click', function () {
                                document.querySelectorAll('.zc ul li').forEach(li => li.classList.remove('on'));
                                this.classList.add('on');
                                switch (index) {
                                    case 0:
                                        filterRequests(null);
                                        break;
                                    case 1:
                                        filterRequests(0);
                                        break;
                                    case 2:
                                        filterRequests(1);
                                        break;
                                    case 3:
                                        filterRequests(2);
                                        break;
                                }
                            });
                        });
                    </script>
                    <div id="chatOverlay" class="chat-overlay hidden">
                        <div class="chat-content">
                            <div class="chat-header">
                                <h4 id="chatTitle" style="font-size:.17rem;">Phản hồi</h4>
                                <button id="closeChat" class="btn-close" style="padding: .07rem; font-size: .17rem; border: none;">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>
                            <div id="chatBody" class="chat-body">
                            </div>
                            <div class="chat-container">
                                <form asp-action="SendMessage" asp-controller="TblRequestsProcessings" method="post" class="chat-form">
                                    <input type="hidden" id="requestIdInput" name="RequestId" />
                                    <textarea id="messageInput"
                                              name="message"
                                              class="chat-textarea"
                                              placeholder="Nhập tin nhắn..."
                                              rows="1"
                                              required></textarea>
                                    <button class="send-button" type="submit">
                                        <i class="bi bi-send"></i>
                                    </button>
                                </form>
                            </div>
                            <script>
                                const textarea = document.getElementById("messageInput");
                                textarea.addEventListener("input", function () {
                                    this.style.height = "24px";
                                    const newHeight = Math.min(this.scrollHeight, 100);
                                    this.style.height = newHeight + "px";
                                });
                            </script>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


