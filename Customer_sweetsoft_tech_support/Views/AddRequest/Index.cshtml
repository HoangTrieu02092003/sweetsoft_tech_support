
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <title>Thêm Yêu Cầu</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }
        .containerrr {
            width: 80%;
            margin: 0 auto;
            padding: 20px;
        }
        .headerrr {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .headerrr img {
            height: 50px;
        }
        .headerrr .infooo {
            text-align: right;
        }
        form {
            padding: 20px;
            border-radius: 5px;
            background: #f9f9f9;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        .form-group input, .form-group textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }
        .form-actionss {
            text-align: right;
        }
        .add-buttonn, .submit-buttonn {
            background-color: #6200ea;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .add-buttonn {
            margin-bottom: 20px;
        }
        .remove-buttonn {
            background-color: #d32f2f;
            color: white;
            padding: 5px 10px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .captchaa {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .captchaa img {
            margin-left: 10px;
        }

        .section-title {
            font-weight: bold;
            margin-bottom: 10px;
        }

        .d-flex {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
    </style>

</head>
<body class="show">
    <div class="inner_bn">
        <img src="~/layoutuser/img/inner.jpg" />
    </div>
    <div class="inner_main">
        <div class="rem12">
            <div class="dqwz">
                <a href="@Url.Action("Index", "Home")">Trang Chủ</a>
                /
                <a href="@Url.Action("Index", "AddRequest")">Gửi Yêu Cầu</a>
            </div>
            <div class="zb_nr">
                <div class="containerrr">
                    <form id="requestForm" method="post" action="/request/submit">
                        <h2 class="section-title">PHIẾU GỬI YÊU CẦU</h2>
                        
                        <p class="section-title">Thông tin người yêu cầu</p>
                        <div class="form-group-inlinee">
                            <div class="form-group">
                                <label for="name">Họ tên (*)</label>
                                <input type="text" id="name" name="name" required>
                            </div>
                            <div class="form-group">
                                <label for="company">Đơn vị (*)</label>
                                <input type="text" id="company" name="company" required>
                            </div>
                        </div>
                        <div class="form-group-inlinee">
                            <div class="form-group">
                                <label for="email">Email (*)</label>
                                <input type="email" id="email" name="email" required>
                            </div>
                            <div class="form-group">
                                <label for="phone">Số điện thoại (*)</label>
                                <input type="tel" id="phone" name="phone" required>
                            </div>
                        </div>

                        <div class="d-flex">
                            <p class="section-title">Thông tin yêu cầu</p>
                            <button type="button" class="add-buttonn" onclick="addRequestFields()">+ Thêm</button>
                        </div>
                        <div id="requestDetails">
                            <div class="form-group request-entry">
                                <label for="projectName">Tên dự án (*)</label>
                                <input type="text" id="projectName" name="projectName[]" required>
                            </div>
                            <div class="form-group">
                                <label for="title">Tiêu đề (*)</label>
                                <input type="text" id="title" name="title[]" required>
                            </div>
                            <div class="form-group">
                                <label for="description">Mô tả (*)</label>
                                <textarea id="description" name="description[]" required></textarea>
                            </div>
                        </div>

                        <div class="form-group captchaa">
                            <label for="captcha">Bạn không phải là người máy</label>
                            <img src="https://www.gstatic.com/recaptcha/api2/logo_48.png" alt="reCAPTCHA">
                        </div>

                        <div class="form-actionss">
                            <button type="submit" class="submit-buttonn">Gửi yêu cầu</button>
                        </div>
                    </form>
                </div>

                <script>
                    function addRequestFields() {
                        const requestDetails = document.getElementById('requestDetails');
                        const newFields = document.createElement('div');
                        newFields.className = 'request-entry';
                        newFields.innerHTML = `
                                                <hr />
                            <div class="form-group">
                                <label for="title">Tiêu đề (*)</label>
                                <input type="text" name="title[]" required>
                            </div>
                            <div class="form-group">
                                <label for="description">Mô tả (*)</label>
                                <textarea name="description[]" required></textarea>
                            </div>
                            <button type="button" class="remove-buttonn" onclick="removeRequestFields(this)">Xóa</button>
                        `;
                        requestDetails.appendChild(newFields);
                    }

                    function removeRequestFields(button) {
                        const entry = button.parentElement;
                        entry.remove();
                    }
                </script>
            </div>
        </div>
    </div>
</body>
</html>






