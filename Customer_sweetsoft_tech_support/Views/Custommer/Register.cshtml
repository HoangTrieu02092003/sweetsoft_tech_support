@model Customer_sweetsoft_tech_support.Models.TblCustomer

@{
    ViewData["Title"] = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- stylesheet -->
<link href="~/layoutuser/style/mystyle.css" rel="stylesheet" />
<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .register-container {
        width: 100%;
        max-width: 400px;
        border: 1px solid #6a1b9a;
        padding: 15px;
        border-radius: 8px;
        background: #f9f9f9;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .register-title {
        font-size: 1.5rem;
        font-weight: bold;
        color: #6a1b9a;
        margin-bottom: 1rem;
    }

    .form-floating-label {
        position: relative;
        margin-bottom: 1.5rem;
    }

    .form-floating-label input {
        width: 100%;
        padding: 12px 16px;
        font-size: 1rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        background: transparent;
        outline: none;
        transition: all 0.2s ease-in-out;
    }

    .form-floating-label label {
        position: absolute;
        top: 50%;
        left: 16px;
        transform: translateY(-50%);
        padding: 0 4px;
        font-size: 1rem;
        color: #aaa;
        pointer-events: none;
        transition: all 0.2s ease-in-out;
    }

    .form-floating-label input:focus {
        border-color: #6a1b9a;
    }

    .form-floating-label input:focus + label,
    .form-floating-label input:not(:placeholder-shown) + label {
        top: -8px;
        transform: translateY(0) scale(0.85);
        background-color: #f9f9f9;
        color: #6a1b9a;
    }

    .form-group {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 15px;
    }

    .form-item {
        flex: 1 1 calc(50% - 20px); /* Hai phần tử chia đều 50% chiều rộng */
    }

    .input-group-text {
        position: absolute;
        top: 50%;
        right: 10px;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
    }

    .input-group-text:hover {
        color: #ffb300;
    }

    label {
        display: block;
        margin-bottom: 5px;
    }

    input[type="text"] {
        width: 100%;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    button {
        background-color: #ffb300;
        border-color: #ffb300;
        color: #fff;
    }

    button:hover {
        background-color: #ff9800;
        border-color: #ff9800;
    }
</style>

<!-- Register Form -->
<div class="d-flex justify-content-center align-items-center">
    <div class="register-container">
        <h2 class="register-title text-center">Đăng ký tài khoản</h2>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">
                @TempData["Message"]
            </div>
        }

        <form asp-action="Register" method="post" class="needs-validation" novalidate>
            <div class="form-floating-label">
                <input asp-for="FullName" placeholder="" required pattern="[A-Za-z\s]{3,50}" title="Tên phải từ 3 đến 50 ký tự chữ cái." />
                <label asp-for="FullName">Họ và tên</label>
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-floating-label">
                <input asp-for="Email" placeholder="" type="email" required 
                    pattern="[a-z0-9._%+-]+[a-z0-9.-]+\.[a-z]{2,}$" 
                    title="Vui lòng nhập một địa chỉ email hợp lệ. Ví dụ: example@domain.com" />
                <label asp-for="Email">Email</label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-floating-label">
                <input asp-for="Phone" placeholder="" type="tel" required pattern="[0-9]{10}" title="Số điện thoại phải chứa 10 chữ số." />
                <label asp-for="Phone">Số điện thoại</label>
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="form-group">
                <div class="form-floating-label form-item">
                    <input asp-for="TaxCode" placeholder="" required
                           pattern="^\d{10}(-\d{3})?$"
                           title="Mã số thuế gồm 10 chữ số hoặc 13 chữ số (định dạng 0123456789 hoặc 0123456789-001)." />
                    <label asp-for="TaxCode">Mã số thuế</label>
                    <span asp-validation-for="TaxCode" class="text-danger"></span>
                </div>

                <div class="form-floating-label form-item">
                    <input asp-for="Company" placeholder="" />
                    <label asp-for="Company">Công ty</label>
                    <span asp-validation-for="Company" class="text-danger"></span>
                </div>
            </div>

            <div class="form-floating-label">
                <input asp-for="Username" placeholder="" required pattern="[A-Za-z0-9_]{5,20}" title="Tên đăng nhập phải từ 5 đến 20 ký tự, chỉ chứa chữ cái, số và dấu gạch dưới." />
                <label asp-for="Username">Tên đăng nhập</label>
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-floating-label">
                <input asp-for="Password" type="password" placeholder="" required />
                <label asp-for="Password">Mật khẩu</label>
                <span class="input-group-text" id="togglePassword">
                    <i class="fas fa-eye"></i>
                </span>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- Google reCAPTCHA -->
            <div class="g-recaptcha mb-3 w-100" data-sitekey="@ViewBag.SiteKey" data-callback="verifyCaptcha"></div>
            <!-- Thêm trường để lưu trữ giá trị reCAPTCHA -->
            <input type="hidden" id="recaptchaResponse" name="g-recaptcha-response" />
            <!-- Hidden fields for default values -->
            @* Hidden fields, use readonly inputs for view model properties *@
            @Html.HiddenFor(model => model.Status, new { @class = "form-control", value = "0" })
            @Html.HiddenFor(model => model.IsDelete, new { @class = "form-control", value = "false"})
            @Html.HiddenFor(model => model.ResetToken, new { @class = "form-control", value = "" })
            @Html.HiddenFor(model => model.ResetTokenExpiry, new { @class = "form-control", value = "" })
            @Html.HiddenFor(model => model.Token, new { @class = "form-control", value = "" })
            @Html.HiddenFor(model => model.TokenExpiry, new { @class = "form-control", value = "" })
            @Html.HiddenFor(model => model.CreatedBy, new { @class = "form-control", value = "" })
            @Html.HiddenFor(model => model.CreatedAt, new { @class = "form-control", value = DateTime.Now })
            @Html.HiddenFor(model => model.UpdatedBy, new { @class = "form-control", value = "" })
            @Html.HiddenFor(model => model.UpdatedAt, new { @class = "form-control", value = DateTime.Now })

           <div class="text-center">
                <button type="submit" class="btn btn-warning">Đăng ký</button>
           </div>
        </form>
        <div class="mt-4 text-center">
            <a asp-action="Login" style="color: #6a1b9a;">Quay lại trang đăng nhập</a>
        </div>
    </div>
</div>

<!-- Script to handle client-side validation -->
<script>

    // Show/Hide Password
    const togglePassword = document.querySelector('#togglePassword');
    const passwordField = document.querySelector('#Password');

    togglePassword.addEventListener('click', () => {
        const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordField.setAttribute('type', type);

        // Toggle icon
        togglePassword.innerHTML =
            type === 'password'
                ? '<i class="fas fa-eye"></i>'
                : '<i class="fas fa-eye-slash"></i>';
    });
</script>
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/js/all.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>