@model IEnumerable<Customer_sweetsoft_tech_support.Models.TblRequestFeedback>

@if (!Model.Any())
{
    <div class="chat-message system-message">
        <p>Không có phản hồi nào.</p>
    </div>
}
else
{
    @foreach (var feedback in Model)
    {
        <div class="chat-message @(feedback.FromUserId != null ? "from-customer" : "from-user")">
            <div class="message-header">
                <strong>@(feedback.FromUserId != null ? "Nhân viên" : "Khách hàng")</strong>
                <span class="timestamp">@feedback.CreatedAt.ToString("HH:mm dd/MM/yyyy")</span>
            </div>
            <div class="message-content">
                <p>@feedback.Feedback</p>
            </div>
        </div>
    }
}

<style>
    .chat-message {
        margin-bottom: 15px;
        padding: 10px;
        border-radius: 10px;
        max-width: 70%;
        transition: background-color 0.3s ease;
    }

    .from-user {
        background-color: #d1ecf1;
        margin-left: auto;
        text-align: right;
    }

    .from-customer {
        background-color: #f8d7da;
        margin-right: auto;
        text-align: left;
    }

    .system-message {
        text-align: center;
        font-style: italic;
        color: #aaa;
    }

    .message-header {
        font-size: .19rem;
        color: #666;
    }

    .timestamp {
        margin-left: 10px;
    }

    .message-content p {
        margin: 0;
        padding: 5px 0;
    }
</style>