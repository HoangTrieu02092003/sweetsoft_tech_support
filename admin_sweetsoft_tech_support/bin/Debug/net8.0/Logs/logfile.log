    WHEN [t3].[status] = CAST(1 AS smallint) THEN N'Pending'
    WHEN [t3].[status] = CAST(2 AS smallint) THEN N'Processing'
    WHEN [t3].[status] = CAST(3 AS smallint) THEN N'Completed'
    WHEN [t3].[status] = CAST(4 AS smallint) THEN N'Cannot be Resolved'
    ELSE N'Unknown'
END, [t3].[created_at]
FROM (
    SELECT COALESCE([t].[customer_id], 0) AS [c], (
        SELECT TOP(1) [t2].[full_name]
        FROM [TblSupport_Requests] AS [t1]
        LEFT JOIN [TblCustomers] AS [t2] ON [t1].[customer_id] = [t2].[customer_id]
        WHERE [t].[customer_id] = [t1].[customer_id] OR ([t].[customer_id] IS NULL AND [t1].[customer_id] IS NULL)) AS [c0], COUNT(*) AS [c1], [t].[customer_id]
    FROM [TblSupport_Requests] AS [t]
    GROUP BY [t].[customer_id]
) AS [t0]
LEFT JOIN [TblSupport_Requests] AS [t3] ON [t0].[customer_id] = [t3].[customer_id]
ORDER BY [t0].[customer_id] 
