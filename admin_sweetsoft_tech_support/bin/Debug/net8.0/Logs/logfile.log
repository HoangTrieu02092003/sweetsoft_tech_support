    WHEN [t3].[status] = CAST(2 AS smallint) THEN N'Processing'
    WHEN [t3].[status] = CAST(3 AS smallint) THEN N'Completed'
    WHEN [t3].[status] = CAST(4 AS smallint) THEN N'Cannot be Resolved'
