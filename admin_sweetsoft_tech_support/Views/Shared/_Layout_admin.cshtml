<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="shortcut icon" type="image/png" href="~/images/logos/logo-removebg.png">
    <!--font-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link href="~/assets/libs/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/assets/css/styles.min.css">
    <link href="~/css/sort.css" rel="stylesheet" />
    <script src="~/js/sort.js"></script>
    <script src="~/js/set.js"></script>
    <style>
        body{
            font-family: Barlow !important;
        }

        .logo-img img{
            width: 80%;
            height: auto;
        }


        .notification-tooltip {
            line-height: 2.5;
            padding: 0 3px;
            font-size: 16px;
            display: none; /* Ẩn thông báo ngắn gọn ban đầu */
            position: absolute;
            top: 8%;
            left: 60px;
            background-color: rgba(0, 0, 0, 0.8); /* Màu nền tối với độ trong suốt */
            color: white; /* Màu chữ trắng */
            border-radius: 5px;
            white-space: nowrap; /* Không cho phép xuống dòng */
            z-index: 1; /* Đảm bảo rằng nó nằm trên các phần tử khác */
        }

        .nav-item:hover .notification-tooltip {
            display: block;
        }

    </style>
</head>

<body>
    <!--  Body Wrapper -->
    <div class="page-wrapper" id="main-wrapper" data-layout="vertical" data-navbarbg="skin6" data-sidebartype="full" data-sidebar-position="fixed" data-header-position="fixed">
        <!-- Sidebar Start -->
        <aside class="left-sidebar">
            <div>
                <div class="brand-logo d-flex align-items-center justify-content-between">
                    <a asp-action="Index1" asp-controller="Report" class="text-nowrap logo-img">
                        <img src="~/assets/images/logos/sweetsoft-logo-dark.svg" alt="Logo">
                    </a>
                    <div class="close-btn d-xl-none d-block sidebartoggler cursor-pointer" id="sidebarCollapse">
                        <i class="ti ti-x fs-8"></i>
                    </div>
                </div>
                <nav class="sidebar-nav scroll-sidebar" data-simplebar>
                    <ul id="sidebarnav" class="list-unstyled">
                        <li class="nav-small-cap">
                            <i class="ti ti-dots nav-small-cap-icon fs-6"></i>
                            <span class="hide-menu">Home</span>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" asp-action="Index1" asp-controller="Report" aria-expanded="false">
                                <span><iconify-icon icon="solar:layers-minimalistic-bold-duotone" class="fs-6"></iconify-icon></span>
                                <span class="hide-menu">Báo cáo</span>
                            </a>
                        <li class="nav-small-cap" style="@(User.Claims.FirstOrDefault(c => c.Type == "IsAdmin")?.Value == "True" ? "" : "display:none")">
                            <i class="ti ti-dots nav-small-cap-icon fs-6"></i>
                            <span class="hide-menu">Quản lý log</span>
                        </li>

                        <!-- Thêm phần mình làm ở đây nhen mn -->
                        
                        <li class="sidebar-item" style="@(User.Claims.FirstOrDefault(c => c.Type == "IsAdmin")?.Value == "True" ? "" : "display:none")">
                            <a class="sidebar-link" asp-action="Index" asp-controller="AuditLogs" asp-route-date="@DateTime.Now.ToString("yyyy-MM-dd")" asp-route-filterOption="day" aria-expanded="false">
                                <span><iconify-icon icon="solar:layers-minimalistic-bold-duotone" class="fs-6"></iconify-icon></span>
                                <span class="hide-menu">Quản lý nhật ký kiểm tra</span>
                            </a>
                        </li>

                        <li class="sidebar-item" style="@(User.Claims.FirstOrDefault(c => c.Type == "IsAdmin")?.Value == "True" ? "" : "display:none")">
                            <a class="sidebar-link" asp-action="Index" asp-controller="Sessions" aria-expanded="false">
                                <span><iconify-icon icon="solar:layers-minimalistic-bold-duotone" class="fs-6"></iconify-icon></span>
                                <span class="hide-menu">Quản lý Session</span>
                            </a>
                        </li>
                        <li class="sidebar-item" style="@(User.Claims.FirstOrDefault(c => c.Type == "IsAdmin")?.Value == "True" ? "" : "display:none")">
                            <a class="sidebar-link" asp-action="Index" asp-controller="Notifications" aria-expanded="false">
                                <span><iconify-icon icon="solar:layers-minimalistic-bold-duotone" class="fs-6"></iconify-icon></span>
                                <span class="hide-menu">Quản lý thông báo</span>
                            </a>
                        </li>
                        <li class="sidebar-item" style="@(User.Claims.FirstOrDefault(c => c.Type == "IsAdmin")?.Value == "True" ? "" : "display:none")">
                            <a class="sidebar-link" asp-action="Index" asp-controller="ActivityLogs" aria-expanded="false">
                                <span><iconify-icon icon="solar:layers-minimalistic-bold-duotone" class="fs-6"></iconify-icon></span>
                                <span class="hide-menu">Nhật ký yêu cầu hỗ trợ</span>
                            </a>
                        </li>
                        <li class="nav-small-cap">
                            <i class="ti ti-dots nav-small-cap-icon fs-6"></i>
                            <span class="hide-menu">Quản Lý</span>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" asp-action="Index" asp-controller="TblCustomers" aria-expanded="false">
                                <span><iconify-icon icon="solar:layers-minimalistic-bold-duotone" class="fs-6"></iconify-icon></span>
                                <span class="hide-menu">Quản lý khách hàng</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" asp-action="Index" asp-controller="TblSupportRequests" aria-expanded="false">
                                <span><iconify-icon icon="solar:layers-minimalistic-bold-duotone" class="fs-6"></iconify-icon></span>
                                <span class="hide-menu">Quản lý yêu cầu</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" asp-action="Index" asp-controller="TblDepartments" aria-expanded="false">
                                <span><iconify-icon icon="solar:layers-minimalistic-bold-duotone" class="fs-6"></iconify-icon></span>
                                <span class="hide-menu">Quản lý phòng ban</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" asp-action="Index" asp-controller="TblUsers" aria-expanded="false">
                                <span><iconify-icon icon="solar:layers-minimalistic-bold-duotone" class="fs-6"></iconify-icon></span>
                                <span class="hide-menu">Quản lý người dùng</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" asp-action="Index" asp-controller="TblFaqs" aria-expanded="false">
                                <span><iconify-icon icon="solar:layers-minimalistic-bold-duotone" class="fs-6"></iconify-icon></span>
                                <span class="hide-menu">Quản lý FAQ</span>
                            </a>
                        </li>
                        <!-- Thêm phần mình làm ở đây nhen mn -->

                    </ul>
                </nav>
            </div>
        </aside>
        <!-- Sidebar End -->
        <!-- Main Wrapper -->
        <div class="body-wrapper">
            <!-- Header Start -->
            <header class="app-header">
                <nav class="navbar navbar-expand-lg navbar-light">
                    <ul class="navbar-nav">
                        <li class="nav-item d-block d-xl-none">
                            <a class="nav-link sidebartoggler nav-icon-hover" id="headerCollapse" href="javascript:void(0)">
                                <i class="ti ti-menu-2"></i>
                            </a>
                        </li>
                        <li class="nav-item position-relative">
                            <a class="nav-link nav-icon-hover" asp-action="MyNotifications" asp-controller="Notifications">
                                @await Component.InvokeAsync("Notification")
                                <i class="ti ti-bell-ringing"></i>
                            </a>
                            @await Component.InvokeAsync("UnreadNotifications")
                        </li>
                    </ul>
                    <div class="navbar-collapse justify-content-end px-0" id="navbarNav">
                        <ul class="navbar-nav flex-row ms-auto align-items-center justify-content-end">
                            <li class="nav-item dropdown">
                                <a class="nav-link" href="javascript:void(0)" id="drop2" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="~/assets/images/profile/user-1.jpg" alt="User" width="35" height="35" class="rounded-circle m-2">
                                    <span class="d-lg-block d-none" >
                                        @User.Identity.Name
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-animate-up" aria-labelledby="drop2">
                                    <li><a class="dropdown-item" asp-action="MyAccount" asp-controller="TblUsers"><i class="ti ti-user fs-6"></i> Hồ sơ</a></li>
                                    <li><a class="dropdown-item" asp-action="ForgotPassword" asp-controller="Admin"><i class="ti ti-lock fs-6"></i> Reset mật khẩu</a></li>               
                                   <li><a class="dropdown-item" asp-action="Logout" asp-controller="Admin"><i class="ti ti-logout fs-6"></i> Đăng xuất</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </nav>
            </header>
            <!-- Header End -->

            <div class="container-fluid">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/scripts.js"></script>
    <script src="~/assets/js/sidebarmenu.js"></script>
    <script src="~/assets/js/app.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var notificationIcons = document.querySelectorAll('.nav-icon-hover');

            notificationIcons.forEach(function (icon) {
                icon.addEventListener('mouseenter', function () {
                    var tooltip = icon.querySelector('.notification-tooltip');
                    if (tooltip) {
                        tooltip.style.display = 'block';
                    }
                });

                icon.addEventListener('mouseleave', function () {
                    var tooltip = icon.querySelector('.notification-tooltip');
                    if (tooltip) {
                        tooltip.style.display = 'none';
                    }
                });
            });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>

</html>
