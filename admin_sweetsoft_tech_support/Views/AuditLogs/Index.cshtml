@model Tuple<List<dynamic>, List<dynamic>>
@{
    ViewData["Title"] = "Quản lý Audit Logs";
}

<div class="container mt-4">
    <h1 class="text-center">Quản lý Nhật ký Kiểm tra</h1>

    <!-- Tab navigation -->
    <div class="d-flex justify-content-between">
        <div>
            <ul class="nav nav-tabs" id="logTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <a class="nav-link active" id="database-tab" data-bs-toggle="tab" href="#database" role="tab" aria-controls="database" aria-selected="true">Từ database</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" id="file-tab" data-bs-toggle="tab" href="#file" role="tab" aria-controls="file" aria-selected="false">Từ File</a>
                </li>
            </ul>
        </div>
        <div>
            <a asp-action="ExportToExcel" class="btn btn-success">Xuất file</a>
        </div>
    </div>
    <!-- Tab content -->
    <div class="tab-content mt-3" id="logTabsContent">
        <!-- Tab 1: Cơ sở dữ liệu -->
        <div class="tab-pane fade show active" id="database" role="tabpanel" aria-labelledby="database-tab">
            <!-- Form tìm kiếm -->
            <form method="get" class="mt-4">
                <div class="row">
                    <div class="col-md-3">
                        <input type="text" name="tableName" class="form-control" placeholder="Lọc theo bảng" />
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="changedBy" class="form-control" placeholder="Lọc theo người thay đổi" />
                    </div>
                    <div class="col-md-3">
                        <select name="actionType" class="form-control">
                            <option value="">-- Lọc theo hành động --</option>
                            <option value="INSERT">Thêm</option>
                            <option value="UPDATE">Chỉnh sửa</option>
                            <option value="DELETE">Xóa</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary">Lọc</button>
                    </div>
                </div>
            </form>
            <!-- Xuất file -->
            <div class="d-flex justify-content-end">
                <a href="@Url.Action("ExportToExcel", "AuditLogs")" class="btn btn-success">Xuất Exel</a>

            </div>
            <!-- Danh sách Audit Logs -->
            <table class="table table-bordered table-striped mt-4">
                <thead class="thead-dark">
                    <tr>
                        <th>Bảng</th>
                        <th>Hành động</th>
                        <th>Người thực hiện</th>
                        <th>Thời gian</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Item1)
                    {
                        <tr>
                            <td>@log.TableName</td>
                            <td>@log.ActionType</td>
                            <td>@log.ChangedByNavigation?.FullName</td>
                            <td>@log.ChangedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a href="@Url.Action("Details", "AuditLogs", new { id = log.AuditId })" class="btn btn-info btn-sm">Xem</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <!-- Phân trang -->
            <div class="d-flex justify-content-center my-4">
                <ul class="pagination">
                    @if (ViewData["CurrentPage"] != null && (int)ViewData["CurrentPage"] > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = 1 })">Đầu</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["CurrentPage"] - 1 })">Trước</a>
                        </li>
                    }

                    @if (ViewData["TotalPages"] != null)
                    {
                        int totalPages = (int)ViewData["TotalPages"];
                        for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == (int)ViewData["CurrentPage"] ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                            </li>
                        }
                    }

                    @if (ViewData["CurrentPage"] != null && (int)ViewData["CurrentPage"] < (int)ViewData["TotalPages"])
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["CurrentPage"] + 1 })">Sau</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["TotalPages"] })">Cuối</a>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Tab 2: From File -->
        <div class="tab-pane fade" id="file" role="tabpanel" aria-labelledby="file-tab">
            <table class="table table-bordered table-striped mt-4">
                <thead class="thead-dark">
                    <tr>
                        <th>Bảng</th>
                        <th>Hành động</th>
                        <th>Người thực hiện</th>
                        <th>Thời gian</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Item2)
                    {
                        <tr>
                            <td>@log.TableName</td>
                            <td>@log.ActionType</td>
                            <td>@log.ChangedByNavigation?.FullName</td>
                            <td>@log.ChangedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>