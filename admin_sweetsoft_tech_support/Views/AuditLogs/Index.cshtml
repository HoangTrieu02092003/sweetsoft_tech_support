@model IEnumerable<TblAuditLog>
@{
    ViewData["Title"] = "Quản lý Audit Logs";
}

<div class="container mt-4">
    <h1 class="text-center">Quản lý Nhật ký Kiểm tra</h1>

    <!-- Form tìm kiếm -->
    <form method="get" class="mt-4">
        <div class="row">
            <div class="col-md-3">
                <input type="text" name="tableName" class="form-control" placeholder="Lọc theo bảng" />
            </div>
            <div class="col-md-3">
                <input type="text" name="changedBy" class="form-control" placeholder="Lọc theo người thay đổi" />
            </div>
            <div class="col-md-3">
                <select name="actionType" class="form-control">
                    <option value="">-- Lọc theo hành động --</option>
                    <option value="INSERT">INSERT</option>
                    <option value="UPDATE">UPDATE</option>
                    <option value="DELETE">DELETE</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary">Lọc</button>
            </div>
        </div>
    </form>
    <!-- Xuất file -->
    <div class="d-flex justify-content-end">
        <a href="@Url.Action("ExportToExcel", "AuditLogs")" class="btn btn-success">Xuất Exel</a>

    </div>
    <!-- Danh sách Audit Logs -->
    <table class="table table-bordered table-striped mt-4">
        <thead class="thead-dark">
            <tr>
                <th>Bảng</th>
                <th>Bản ghi</th>
                <th>Hành động</th>
                <th>Người thay đổi</th>
                <th>Thời gian</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.TableName</td>
                    <td>@log.RecordId</td>
                    <td>@log.ActionType</td>
                    <td>@log.ChangedByNavigation?.FullName</td>
                    <td>@log.ChangedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <a href="@Url.Action("Details", "AuditLogs", new { id = log.AuditId })" class="btn btn-info btn-sm">Xem</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Phân trang -->
<div class="d-flex justify-content-center my-4">
    <ul class="pagination">
        @if (ViewData["CurrentPage"] != null && (int)ViewData["CurrentPage"] > 1)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = 1, status = ViewBag.Status, role = ViewBag.Role })">Đầu</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["CurrentPage"] - 1, status = ViewBag.Status, role = ViewBag.Role })">Trước</a>
            </li>
        }

        @if (ViewData["TotalPages"] != null)
        {
            int totalPages = (int)ViewData["TotalPages"];
            for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == (int)ViewData["CurrentPage"] ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = i, status = ViewBag.Status, role = ViewBag.Role })">@i</a>
                </li>
            }
        }

        @if (ViewData["CurrentPage"] != null && (int)ViewData["CurrentPage"] < (int)ViewData["TotalPages"])
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["CurrentPage"] + 1, status = ViewBag.Status, role = ViewBag.Role })">Sau</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["TotalPages"], status = ViewBag.Status, role = ViewBag.Role })">Cuối</a>
            </li>
        }
    </ul>
</div>