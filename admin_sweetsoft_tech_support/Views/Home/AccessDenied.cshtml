<style>
    form button.btn-link {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
    }
</style>
<div class="d-flex justify-content-center align-items-center w-100 bg-light">
    <div class="text-center">
        <!-- Hình ảnh minh họa lỗi -->
        <img src="~/assets/images/blog/bug.jpg" alt="Error" class="img-fluid" style="max-width: 300px;">

        <!-- Thông báo lỗi -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-4">
                <strong>Oops! Có lỗi xảy ra:</strong>
                @TempData["ErrorMessage"]
            </div>
        }   

        <!-- Các nút hỗ trợ người dùng -->
        <div class="mt-4">
            <button class="btn btn-outline-dark" onclick="window.history.back()">Quay lại</button>
            <a href="/" class="btn btn-primary ml-2">Về trang đăng nhập</a>
        </div>

        <div class="mt-3">
            <p class="text-center mt-3">
                Hoặc bạn có thể
                <form method="post" asp-action="RequestPermission" asp-controller="Home" class="d-inline-block">
                    <input type="hidden" name="requestedPermission" value="@ViewData["permission"]" />
                    <button type="submit" class="btn-link btn-sm">
                        Xin cấp quyền
                    </button>
                </form>
                nếu cần.
            </p>
        </div>
    </div>
</div>
