@model IEnumerable<TblSession>
@using admin_sweetsoft_tech_support.Attributes
@{
    ViewData["Title"] = "Quản lý Phiên làm việc";
    int stt = 1;
}

<style>
    .text-truncate {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .badge {
        color: black;
        font-size: 0.9rem;
    }
    
    th{
        white-space: nowrap;
    }
</style>


<div class="container mt-4">
    <h1 class="text-center">Quản lý phiên làm việc</h1>
    <!-- Bộ lọc và tìm kiếm -->
    <form method="get" asp-action="Index">
        <div class="row mb-3">
            <div class="col-md-3">
                @Html.GenerateFilterTextbox(
                    id: "name",
                    name: "name",
                    placeholder: "Tìm kiếm ...",
                    value: ViewData["name"]?.ToString() ?? "",
                    includeCancelButton: false
                )
            </div>
            <div class="col-md-3">
                @Html.GenerateFilterDropdown(
                id: "status",
                name: "status",
                options: new Dictionary<string, string>
                    {
                        {"active","Còn hiệu lực"},
                        {"expired","Hết hạn"}
                    },
                selectedValue: ViewData["status"]?.ToString() ?? "",
                includeCancelButton: false
                )
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary">Lọc</button>
            </div>
        </div>
    </form>

    <!-- Danh sách Sessions -->
    <div class="table-responsive">
        <table class="table table-bordered table-striped mt-4">
        <thead class="thead-dark">
            <tr>
                <th>STT</th>
                <th>Người dùng</th>
                <th>Session Token</th>
                <th>Ngày tạo</th>
                <th>Hết hạn</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var session in Model)
            {
                <tr>
                    <td>@stt</td>
                    <td>@session.User.FullName</td>
                    <td>
                        <div class="text-truncate" style="max-width: 200px;" title="@session.SessionToken">
                            @session.SessionToken
                        </div>
                    </td>
                    <td>@session.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@session.ExpiresAt?.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (session.ExpiresAt > DateTime.Now)
                        {
                            <span class="badge badge-success">Còn hiệu lực</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">Hết hạn</span>
                        }
                    </td>
                    <td>
                        <form method="post" asp-action="EndSession" asp-route-id="@session.SessionId">
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn kết thúc phiên này?');">
                                <span class="d-lg-none d-block">X</span>
                                <span class="d-lg-block d-none">Kết thúc</span>
                            </button>
                        </form>
                    </td>
                </tr>
                stt++;
            }
        </tbody>
    </table>
    </div>
</div>

<!-- Phân trang -->
<div class="d-flex justify-content-center my-4">
    <ul class="pagination">
        @if ((int)ViewData["CurrentPage"] > 1)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = 1, name = ViewData["name"], status = ViewData["status"] })"><i class="bi bi-chevron-double-left"></i></a>
            </li>
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["CurrentPage"] - 1, name = ViewData["name"], status = ViewData["status"] })"><i class="bi bi-chevron-left"></i></a>
            </li>
        }

        @if (ViewData["TotalPages"] != null)
        {
            int totalPages = (int)ViewData["TotalPages"];
            for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == (int)ViewData["CurrentPage"] ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = i, name = ViewData["name"], status = ViewData["status"] })">@i</a>
                </li>
            }
        }

        @if ((int)ViewData["CurrentPage"] < (int)ViewData["TotalPages"])
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["CurrentPage"] + 1, name = ViewData["name"], status = ViewData["status"] })"><i class="bi bi-chevron-right"></i></a>
            </li>
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["TotalPages"], name = ViewData["name"], status = ViewData["status"] })"><i class="bi bi-chevron-double-right"></i></a>
            </li>
        }
    </ul>
</div>