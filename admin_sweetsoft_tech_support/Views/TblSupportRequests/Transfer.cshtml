@model admin_sweetsoft_tech_support.Models.TblRequestTransfer

@{
    ViewData["Title"] = "Transfer";
    var currentUserId = ViewBag.CurrentUserId; // Assuming you pass the current user ID via ViewBag
}
<style>
    :root {
        --primary-color: #6a1b9a;
        --secondary-color: #7b2cbf;
        --warning-color: #f9a825;
        --hover-color: #f57f17;
        --background-color: #f4f0f7;
        --text-color-dark: #333;
        --text-color-light: white;
    }

    h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: bold;
        color: var(--primary-color);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .card-header {
        background-color: var(--secondary-color);
        color: var(--text-color-light);
    }

    .form-control {
        border-radius: 5px;
        padding: 10px;
    }

    .btn-warning {
        background-color: var(--warning-color);
        color: var(--text-color-light);
        border-radius: 5px;
    }

        .btn-warning:hover {
            background-color: var(--hover-color);
        }

    .text-center {
        margin-top: 20px;
    }

    .flex-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .flex-item {
        flex: 1 1 45%;
        min-width: 300px;
    }

    .btn-info {
        margin-top: 10px;
    }
</style>

<div class="container">
    <div class="row">
        <div class="col-12 col-md-8 offset-md-2">
            <div class="card border-0 shadow-lg">
                <div class="card-header d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>
                    <p class="mb-0 text-center flex-grow-1" style="font-size: 24px; margin: 0;">Chuyển giao yêu cầu</p>                   
                </div>

                <div class="card-body" style="background-color: var(--background-color);">
                    <form asp-action="Transfer">
                        <div class="form-group">
                            <label asp-for="RequestId" class="control-label text-dark">Yêu cầu</label>
                            <select asp-for="RequestId" class="form-control" asp-items="ViewBag.RequestId">
                                <option value="" disabled selected>Chọn yêu cầu...</option>
                            </select>
                            <span asp-validation-for="RequestId" class="text-danger"></span>
                            </div>


                        <div class="form-group">
                            <label asp-for="FromDepartmentId" class="control-label text-dark">Phòng ban chuyển từ</label>
                            <select asp-for="FromDepartmentId" class="form-control" asp-items="ViewBag.FromDepartmentId">
                                <option value="" disabled selected>Chọn phòng ban...</option>
                            </select>
                            <span asp-validation-for="FromDepartmentId" class="text-danger"></span>
                        </div>
                        <div id="toDepartmentContainer">
                            <div class="flex-container">
                                <div class="col-sm-12 colForm mt-0" style="border-bottom: 1px dashed #eaeaea; padding-bottom: 30px;"></div>
                                <div class="flex-item">
                                    <div class="form-group">
                                        <label asp-for="ToDepartmentId" class="control-label text-dark">Phòng ban chuyển đến</label>
                                        <select asp-for="ToDepartmentId" class="form-control" asp-items="ViewBag.ToDepartmentId" required>
                                            <option value="" disabled selected>Chọn phòng ban...</option>
                                        </select>
                                        <span asp-validation-for="ToDepartmentId" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="flex-item">
                                    <div class="form-group">
                                        <label asp-for="Priority" class="control-label text-dark">Ưu tiên</label>
                                        <select asp-for="Priority" class="form-control">
                                            <option value="1">Thấp</option>
                                            <option value="2">Trung bình</option>
                                            <option value="3">Cao</option>
                                        </select>
                                        <span asp-validation-for="Priority" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="flex-item">
                                    <div class="form-group">
                                        <label asp-for="TransferredBy" class="control-label text-dark">Người chuyển</label>
                                        <select asp-for="TransferredBy" class="form-control" asp-items="ViewBag.TransferredBy">
                                            @* <option value="" disabled selected>Chọn người...</option> *@
                                        </select>
                                        <span asp-validation-for="TransferredBy" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="flex-item">
                                    <div class="form-group">
                                        <label asp-for="TransferredAt" class="control-label text-dark">Ngày chuyển</label>
                                        <input asp-for="TransferredAt" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss")" readonly />
                                        <span asp-validation-for="TransferredAt" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="flex-item">
                                    <div class="form-group">
                                        <label asp-for="Note" class="control-label text-dark">Ghi chú</label>
                                        <input asp-for="Note" class="form-control" placeholder="Nhập ghi chú (nếu có)..." />
                                        <span asp-validation-for="Note" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <button type="button" class="btn btn-info" id="addDepartmentButton">Thêm phòng ban</button>
                        </div>

                        <form asp-action="Transfer" method="post">
                            <div class="form-group">
                                <!-- Other form fields -->
                            </div>
                            <input type="hidden" name="userName" value="@User.Identity.Name" />
                            <div class="form-group text-center">
                                <input type="submit" value="Chuyển" class="btn btn-success text-white" />
                            </div>
                        </form>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('addDepartmentButton').addEventListener('click', function () {
            var container = document.getElementById('toDepartmentContainer');
            var newFlexContainer = container.children[0].cloneNode(true);
            container.appendChild(newFlexContainer);
        });
    </script>
}
