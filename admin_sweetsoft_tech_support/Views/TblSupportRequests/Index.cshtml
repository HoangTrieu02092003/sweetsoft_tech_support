@model IEnumerable<admin_sweetsoft_tech_support.Models.TblSupportRequest>
@using admin_sweetsoft_tech_support.Attributes
@{
    ViewData["Title"] = "Quản lý Yêu cầu Hỗ trợ";
    int currentPage = ViewData["CurrentPage"] as int? ?? 1;
    int totalPages = ViewData["TotalPages"] as int? ?? 1;
}

<style>
             textare
    a {
             white-space: pre-wrap;

             overflow-wrap: break-word;
             overflow: hidden;
         }
         .chat-button {
             margin-bottom: .1rem;
             margin-left: .15rem;
             background: #fff;
             border: none;
             font-size : .22rem;
         }
         .chat-button::after {
         content: "";
         position: absolute;
         right: 8px;
         width: .1rem;
         height: .1rem;
         background-color: #28a745;
         border-radius: 50%;
         border: 1px solid #fff;
         box-shadow: 0 0 2px rgba(0, 0, 0, 0.1);
     }

         .chat-container {
             display: flex;
             justify-content: center;
             width: 100%;
         }

         .chat-form {
             display: flex;
             align-items: center;
             border-radius: 20px;
             padding: 5px;
             width: 100%;
             gap: 10px;
         }

         .chat-textarea {
             flex-grow: 1;
             max-height: 100px;
             height: 24px;
             resize: none;
             border: none;
             background-color: transparent;
             color: black;
             line-height: 1.5;
             padding: 0 5px;
             overflow-y: auto;
         }

             .chat-textarea::-webkit-scrollbar {
                 width: 0;
             }

             .chat-textarea:focus {
                 outline: none;
             }

         .send-button {
             color: blue;
             border: none;
             border-radius: 50%;
             padding: 10px;
             font-size: 16px;
             cursor: pointer;
             display: flex;
             align-items: center;
             justify-content: center;
         }

             .send-button i {
                 pointer-events: none;
             }

</style>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
<link href="~/css/Index_SupportRequest.css" rel="stylesheet">
<script src="~/js/chatbox.js"></script>

<div class="d-flex justify-content-between align-items-center mb-0">
    <h1 class="my-4" style="color: #6a1b9a; font-size: 24px;">Quản lý Yêu cầu Hỗ trợ</h1>
    <a asp-action="Create" class="btn btn-warning text-dark">
        <i class="bi bi-plus-circle"></i> Tạo mới
    </a>
</div>

<!-- Filter Section -->
<form method="get" action="@Url.Action("Index", "TblSupportRequests")" class="m-3" id="filterForm">
    <div class="row">
        <h5 class="">Bộ tìm kiếm</h5>
        <div class="col-lg-3 col-md-8">
            @Html.GenerateFilterDropdown(
                     id: "status",
                     name: "status",
                     options: new Dictionary<string, string>
            {
            { "0", "Chưa hoàn thành" },
            { "1", "Hoàn thành" },
            { "2", "Không xử lý được" },
            },
                     placeholder: "Trạng thái",
                     selectedValue: ViewData["status"]?.ToString() ?? "",
                     includeCancelButton: false
                     )
        </div>
        <div class="col-lg-3 col-md-8">
            @Html.GenerateFilterTextbox(
                     id: "search",
                     name: "search",
                     placeholder: "Tìm kiếm...",
                     value: ViewData["search"]?.ToString() ?? "",
                     includeCancelButton: false
                     )
        </div>
        <div class="d-lg-none d-block mt-3">
            <button type="submit" class="btn btn-primary w-100">Lọc</button>
        </div>
    </div>
</form>

<!-- Table to Display Support Requests -->
<div class="table-responsive">
    <table class="table table-striped custom-table">
        <thead>
            <tr>
                <th>STT</th>
                <th>
                    <a href="?sortColumn=RequestTitle&sortOrder=@(
            ViewData["SortOrder"] as string == "asc" &&
            ViewData["SortColumn"] as string == "RequestTitle" ? "desc" : "asc")">
                        Tiêu đề
                        <span class="sort-arrow @(ViewData["SortColumn"] as string == "RequestTitle" ? ViewData["SortOrder"] : "")"></span>
                    </a>
                </th>
                <th>
                    <a href="?sortColumn=Status&sortOrder=@(
            ViewData["SortOrder"] as string == "asc" &&
            ViewData["SortColumn"] as string == "Status" ? "desc" : "asc")">
                        Trạng thái
                        <span class="sort-arrow @(ViewData["SortColumn"] as string == "Status" ? ViewData["SortOrder"] : "")"></span>
                    </a>
                </th>
                <th>
                    <a href="?sortColumn=CreatedAt&sortOrder=@(
            ViewData["SortOrder"] as string == "asc" &&
            ViewData["SortColumn"] as string == "CreatedAt" ? "desc" : "asc")">
                        Ngày tạo
                        <span class="sort-arrow @(ViewData["SortColumn"] as string == "CreatedAt" ? ViewData["SortOrder"] : "")"></span>
                    </a>
                </th>
                <th>
                    <a href="?sortColumn=ResolvedAt&sortOrder=@(
            ViewData["SortOrder"] as string == "asc" &&
            ViewData["SortColumn"] as string == "ResolvedAt" ? "desc" : "asc")">
                        Ngày giải quyết
                        <span class="sort-arrow @(ViewData["SortColumn"] as string == "ResolvedAt" ? ViewData["SortOrder"] : "")"></span>
                    </a>
                </th>
                <th>
                    <a href="?sortColumn=CustomerFullName&sortOrder=@(
            ViewData["SortOrder"] as string == "asc" &&
            ViewData["SortColumn"] as string == "CustomerFullName" ? "desc" : "asc")">
                        Khách hàng
                        <span class="sort-arrow @(ViewData["SortColumn"] as string == "CustomerFullName" ? ViewData["SortOrder"] : "")"></span>
                    </a>
                </th>
                <th>
                    <a href="?sortColumn=DepartmentName&sortOrder=@(
            ViewData["SortOrder"] as string == "asc" &&
            ViewData["SortColumn"] as string == "DepartmentName" ? "desc" : "asc")">
                        Phòng ban
                        <span class="sort-arrow @(ViewData["SortColumn"] as string == "DepartmentName" ? ViewData["SortOrder"] : "")"></span>
                    </a>
                </th>
                <th>Hành động</th>
            </tr>
        </thead>


        <tbody>
            @if (Model.Any())
            {
                int stt = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td>@stt</td>
                        <td>@item.RequestTitle</td>
                        <td>
                            <span class="badge @((item.Status == 0 ? "bg-warning" : item.Status == 1 ? "bg-success" : "bg-danger"))">
                                @(item.Status == 0 ? "Chưa hoàn thành" : item.Status == 1 ? "Hoàn thành" : item.Status== 2 ?"Không xử lý được":"Không xác định")
                            </span>
                        </td>
                        <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>@(item.ResolvedAt?.ToString("dd/MM/yyyy") ?? "Chưa giải quyết")</td>
                        <td>@item.Customer?.FullName</td>
                        <td>@item.Department?.DepartmentName</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.RequestId" class="btn btn-outline-info btn-sm">
                                <i class="bi bi-eye"></i>
                            </a>
                            <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.RequestId">
                                <i class="bi bi-trash"></i>
                            </button>
                            @if (item.Status == 0)
                            {
                                <a asp-action="Transfer" asp-route-id="@item.RequestId" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-arrow-right-circle"></i>
                                </a>
                                <button class="btn btn-outline-dark btn-sm open-chat"
                                        data-request-id="@item.RequestId"
                                        data-customer-id="@item.CustomerId"
                                        data-title="@item.RequestTitle"
                                        data-customer="@item.Customer.FullName">
                                    <i class="bi bi-chat-dots"></i>
                                </button>
                                <form method="post" class="d-inline" onsubmit="openStatusModal(event, @item.RequestId)">
                                    <button type="submit" class="btn btn-outline-success btn-sm">
                                        <i class="bi bi-check-circle"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                @* <button class="btn btn-outline-success btn-sm" disabled>
                                    <i class="bi bi-check-circle"></i>
                                </button> *@
                            }

                        </td>
                    </tr>
                    // modal
                    <div class="modal fade" id="deleteModal-@item.RequestId" tabindex="-1" aria-labelledby="deleteModalLabel-@item.RequestId" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="deleteModalLabel-@item.RequestId">Xác nhận xóa yêu cầu hỗ trợ</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    Bạn có chắc chắn muốn xóa yêu cầu hỗ trợ này không?
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                    <!-- Form Xóa -->
                                    <form method="post" asp-action="Delete" asp-route-id="@item.RequestId">
                                        <button type="submit" class="btn btn-danger">Xóa</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    stt++;
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">Không có yêu cầu nào để hiển thị.</td>
                </tr>
            }
        </tbody>
    </table>
    <div id="chatOverlay" class="chat-overlay hidden">
        <div class="chat-content">
            <div class="chat-header">
                <h4 style="font-size:18px; margin: 0;" id="chatTitle">Phản hồi</h4>
                <button id="closeChat" class="btn btn-close"></button>
            </div>
            <div id="chatBody" class="chat-body">
                <!-- Nội dung phản hồi sẽ được load động -->
            </div>
            <div class="chat-container">
                <form asp-action="SendMessage" asp-controller="TblSupportRequests" method="post" class="chat-form">
                    <input type="hidden" id="requestIdInput" name="RequestId" />
                    <input type="hidden" id="ToCustomerIdInput" name="ToCustomerId" />

                    <!-- radio buttons for feedbacktype -->
                    <div>
                        <input type="radio" id="feedbacktypeinput1" name="feedbacktype" value="1" hidden/>
                    </div>
                    <textarea id="messageInput"
                              name="message"
                              class="chat-textarea"
                              placeholder="Nhập tin nhắn..."
                              rows="1"
                              required></textarea>
                    <button class="send-button" type="submit">
                        <i class="bi bi-send"></i>
                    </button>
                </form>
                <script>
                    const textarea = document.getElementById("messageInput");
                    textarea.addEventListener("input", function () {
                        this.style.height = "24px";
                        const newHeight = Math.min(this.scrollHeight, 100);
                        this.style.height = newHeight + "px";
                    });
                </script>
            </div>
        </div>
    </div>
</div>

<!-- Pagination -->
<div class="d-flex justify-content-center my-4">
    <ul class="pagination">
        @if (currentPage > 1)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = 1, status = ViewData["Status"], search = ViewData["Search"], departmentName = ViewData["DepartmentName"], sortColumn = ViewData["SortColumn"], sortOrder = ViewData["SortOrder"] })">
                    <i class="bi bi-chevron-double-left"></i>
                </a>
            </li>
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, status = ViewData["Status"], search = ViewData["Search"], departmentName = ViewData["DepartmentName"], sortColumn = ViewData["SortColumn"], sortOrder = ViewData["SortOrder"] })">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
        }

        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == currentPage ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = i, status = ViewData["Status"], search = ViewData["Search"], departmentName = ViewData["DepartmentName"], sortColumn = ViewData["SortColumn"], sortOrder = ViewData["SortOrder"] })">
                    @i
                </a>
            </li>
        }

        @if (currentPage < totalPages)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, status = ViewData["Status"], search = ViewData["Search"], departmentName = ViewData["DepartmentName"], sortColumn = ViewData["SortColumn"], sortOrder = ViewData["SortOrder"] })">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = totalPages, status = ViewData["Status"], search = ViewData["Search"], departmentName = ViewData["DepartmentName"], sortColumn = ViewData["SortColumn"], sortOrder = ViewData["SortOrder"] })">
                    <i class="bi bi-chevron-double-right"></i>
                </a>
            </li>
        }
    </ul>
</div>

<!-- Modal for selecting status -->
<div class="modal fade" id="statusModal" tabindex="-1" aria-labelledby="statusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="statusModalLabel">Chọn Trạng Thái</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="statusForm" method="post" asp-action="UpdateStatus">
                    <input type="hidden" id="requestId" name="id" />
                    <div class="mb-3">
                        <label for="status" class="form-label">Trạng Thái</label>
                        <select id="status" name="status" class="form-select">
                            <option value="1">Hoàn thành</option>
                            <option value="2">Không xử lý được</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="note" class="form-label">Ghi chú</label>
                        <textarea id="note" name="note" class="form-control"></textarea>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="submitStatusForm()">Lưu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openStatusModal(event, requestId) {
            event.preventDefault();
            document.getElementById('requestId').value = requestId;
            var statusModal = new bootstrap.Modal(document.getElementById('statusModal'));
            statusModal.show();
        }

        function submitStatusForm() {
            var form = document.getElementById('statusForm');
            var status = document.getElementById('status').value;
            form.appendChild(createHiddenInput('resolvedAt', new Date().toISOString()));
            form.appendChild(createHiddenInput('note', document.getElementById('note').value));
            form.submit();
        }


        function createHiddenInput(name, value) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            input.value = value;
            return input;
        }
    </script>
}