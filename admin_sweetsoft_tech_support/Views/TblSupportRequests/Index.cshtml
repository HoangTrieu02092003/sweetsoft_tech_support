@model IEnumerable<admin_sweetsoft_tech_support.Models.TblSupportRequest>

@{
    ViewData["Title"] = "Quản lý Yêu cầu Hỗ trợ";
}
@if (TempData["ErrorMessage"] != null)
{
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
<link href="~/css/Index_SupportRequest.css" rel="stylesheet">

<div class="container mt-4">
    <h1 class="text-center mb-4" style="color: #6a1b9a; font-size: 2rem;">Quản lý Yêu cầu Hỗ trợ</h1>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-3">
        <form method="get" asp-action="Index" asp-controller="TblSupportRequests" class="d-flex flex-wrap mb-3 mb-md-0">
            <select name="status" class="form-select me-2">
                <option value="">Tất cả trạng thái</option>
                <option value="0">Chưa hoàn thành</option>
                <option value="1">Hoàn thành</option>
                <option value="2">Không xử lý được</option>
                <option value="">Không xác định</option>
            </select>
            <button type="submit" class="btn btn-primary"><i class="bi bi-filter"></i> Lọc</button>
        </form>
        <a asp-action="Create" class="btn btn-warning text-dark">
            <i class="bi bi-plus-circle"></i> Tạo mới
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th>Chi tiết yêu cầu</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th>Ngày giải quyết</th>
                    <th>Khách hàng</th>
                    <th>Phòng ban</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                    <tr>
                        <td>
                                @{
                                    string detailsText = item.RequestDetails;
                                    if (detailsText.Length > 30) // Assuming 50 is the max length before truncation
                                    {
                                        detailsText = detailsText.Substring(0, 30) + "...";
                                    }
                                }
                                @detailsText
                        </td>
                        <td>
                                @{
                                    string statusText = item.Status switch
                                    {
                                        0 => "<span class='badge bg-warning text-dark'>Chưa hoàn thành</span>",
                                        1 => "<span class='badge bg-success'>Hoàn thành</span>",
                                        2 => "<span class='badge bg-danger'>Không xử lý được</span>",
                                        _ => "<span class='badge bg-secondary'>Không xác định</span>"
                                    };
                                }
                                @Html.Raw(statusText)
                        </td>
                        <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>@(item.ResolvedAt?.ToString("dd/MM/yyyy") ?? "Chưa giải quyết")</td>
                        <td>@(item.Customer?.FullName ?? "N/A")</td>
                        <td>@(item.Department?.DepartmentName ?? "N/A")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.RequestId" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.RequestId" class="btn btn-outline-info btn-sm">
                                <i class="bi bi-eye"></i>
                            </a>
                            <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.RequestId">
                                <i class="bi bi-trash"></i>
                            </button>
                            <a asp-action="Transfer" asp-route-id="@item.RequestId" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-arrow-right-circle"></i>
                            </a>
                        </td>
                    </tr>

                    <!-- Modal Xác Nhận Xóa -->
                    <div class="modal fade" id="deleteModal-@item.RequestId" tabindex="-1" aria-labelledby="deleteModalLabel-@item.RequestId" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="deleteModalLabel-@item.RequestId">Xác nhận xóa yêu cầu hỗ trợ</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    Bạn có chắc chắn muốn xóa yêu cầu hỗ trợ này không?
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                    <form method="post" asp-action="Delete" asp-route-id="@item.RequestId">
                                        <button type="submit" class="btn btn-danger">Xóa</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    }
                }
                else
                {
            <tr>
                <td colspan="7" class="text-center text-muted">Không có yêu cầu nào để hiển thị.</td>
            </tr>
                }
</tbody>

        </table>
    </div>

    <!-- Phân trang -->
    <div class="d-flex justify-content-center mt-4">
        <ul class="pagination">
            @if (ViewData["CurrentPage"] != null && (int)ViewData["CurrentPage"] > 1)
            {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { page = 1 })">Đầu</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["CurrentPage"] - 1 })">Trước</a>
                    </li>
            }

            @if (ViewData["TotalPages"] != null)
            {
                int totalPages = (int)ViewData["TotalPages"];
                for (int i = 1; i <= totalPages; i++)
                {
                            <li class="page-item @(i == (int)ViewData["CurrentPage"] ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                            </li>
                }
            }

            @if (ViewData["CurrentPage"] != null && (int)ViewData["CurrentPage"] < (int)ViewData["TotalPages"])
            {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["CurrentPage"] + 1 })">Sau</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["TotalPages"] })">Cuối</a>
                    </li>
            }
        </ul>
    </div>
</div>
