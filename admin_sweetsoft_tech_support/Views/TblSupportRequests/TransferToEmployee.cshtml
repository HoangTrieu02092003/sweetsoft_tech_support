@model admin_sweetsoft_tech_support.Models.TblSupportRequest

@{
    ViewData["Title"] = "Chuyển giao yêu cầu cho nhân viên";
    var employees = ViewBag.Employees as List<admin_sweetsoft_tech_support.Models.TblUser>;
    var supportRequest = ViewBag.SupportRequest as admin_sweetsoft_tech_support.Models.TblSupportRequest;
}

<style>
    :root {
        --primary-color: #6a1b9a;
        --secondary-color: #7b2cbf;
        --warning-color: #f9a825;
        --hover-color: #f57f17;
        --background-color: #f4f0f7;
        --text-color-dark: #333;
        --text-color-light: white;
    }

    h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: bold;
        color: var(--primary-color);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .card-header {
        background-color: var(--secondary-color);
        color: var(--text-color-light);
    }

    .form-control {
        border-radius: 5px;
        padding: 10px;
    }

    .btn-warning {
        background-color: var(--warning-color);
        color: var (--text-color-light);
        border-radius: 5px;
    }

        .btn-warning:hover {
            background-color: var(--hover-color);
        }

    .text-center {
        margin-top: 20px;
    }

    .flex-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .flex-item {
        flex: 1 1 45%;
        min-width: 300px;
    }

    .btn-info {
        margin-top: 10px;
    }
</style>
<div class="container">
    <div class="row">
        <div class="col-12 col-md-8 offset-md-2">
            <div class="card border-0 shadow-lg mt-5">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <a asp-action="Details" asp-route-id="@supportRequest?.RequestId" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <p class="mb-0 text-center flex-grow-1" style="font-size: 24px; margin: 0;">Chuyển giao yêu cầu cho nhân viên</p>
                </div>
                <div class="card-body" style="background-color: #f4f0f7;">
                    @if (supportRequest == null)
                    {
                        <div class="alert alert-danger text-center mt-4">
                            Không tìm thấy yêu cầu hỗ trợ.
                        </div>
                    }
                    else
                    {
                        <form method="post">
                            @Html.AntiForgeryToken()

                            <!-- Chọn nhân viên -->
                            <div class="form-group mb-4">
                                <label for="employeeId" class="form-label">Chọn nhân viên:</label>
                                @if (employees == null || !employees.Any())
                                {
                                    <div class="alert alert-warning">
                                        Không có nhân viên nào trong phòng ban để chuyển giao.
                                    </div>
                                }
                                else
                                {
                                    <select id="employeeId" name="employeeId" class="form-select" required>
                                        <option value="">Chọn nhân viên</option>
                                        @foreach (var employee in employees)
                                        {
                                            <option value="@employee.UserId">@employee.FullName</option>
                                        }
                                    </select>
                                }
                            </div>

                            <!-- Ghi chú -->
                            <div class="form-group mb-4">
                                <label for="note" class="form-label">Ghi chú (tuỳ chọn):</label>
                                <textarea id="note" name="note" class="form-control" rows="4" placeholder="Thêm ghi chú khi chuyển giao..."></textarea>
                            </div>

                            <!-- Thông tin yêu cầu hỗ trợ -->
                            <div class="form-group mb-4">
                                <label>Yêu cầu hỗ trợ:</label>
                                <div class="p-3 border bg-white rounded">
                                    <p><strong>Tiêu đề:</strong> @supportRequest.RequestTitle</p>
                                    <p><strong>Sản phẩm:</strong> @supportRequest.Product</p>
                                    <p><strong>Chi tiết:</strong> @supportRequest.RequestDetails</p>
                                    <p><strong>Phòng ban tiếp nhận:</strong> @ViewBag.DepartmentName</p>
                                </div>
                            </div>

                            <input type="hidden" name="id" value="@supportRequest.RequestId" />
                            <input type="hidden" name="RequestId" value="@supportRequest.RequestId" />

                            <!-- Submit button -->
                            <div class="text-center">
                                <button type="submit" class="btn btn-primary px-4 py-2 rounded">
                                    <i class="bi bi-arrow-right-circle"></i> Chuyển giao
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
