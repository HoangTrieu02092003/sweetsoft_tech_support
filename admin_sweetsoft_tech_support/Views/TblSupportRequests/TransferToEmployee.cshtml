@{
    ViewData["Title"] = "Chuyển giao yêu cầu cho nhân viên";
    var employees = ViewBag.Employees as List<admin_sweetsoft_tech_support.Models.TblUser>;
    var supportRequest = ViewBag.SupportRequest as admin_sweetsoft_tech_support.Models.TblSupportRequest;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

<div class="container">
    <div class="row">
        <div class="col-12 col-md-8 offset-md-2">
            <div class="card border-0 shadow-lg mt-5">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <a asp-action="Details" asp-route-id="@supportRequest?.RequestId" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <h5 class="mb-0 text-center flex-grow-1">@ViewData["Title"]</h5>
                </div>
                <div class="card-body">
                    @if (supportRequest == null)
                    {
                        <div class="alert alert-danger text-center mt-4">
                            Không tìm thấy yêu cầu hỗ trợ.
                        </div>
                    }
                    else
                    {
                        <form method="post" class="border p-4 shadow-sm bg-light rounded">
                            @Html.AntiForgeryToken()

                            <!-- Chọn nhân viên -->
                            <div class="form-group mb-4">
                                <label for="employeeId" class="form-label font-weight-bold">Chọn nhân viên:</label>
                                @if (employees == null || !employees.Any())
                                {
                                    <div class="alert alert-warning">
                                        Không có nhân viên nào trong phòng ban để chuyển giao.
                                    </div>
                                }
                                else
                                {
                                    <select id="employeeId" name="employeeId" class="form-select" required>
                                        <option value="">Chọn nhân viên</option>
                                        @foreach (var employee in employees)
                                        {
                                            <option value="@employee.UserId">@employee.FullName</option>
                                        }
                                    </select>
                                }
                            </div>

                            <!-- Ghi chú -->
                            <div class="form-group mb-4">
                                <label for="note" class="form-label font-weight-bold">Ghi chú (tuỳ chọn):</label>
                                <textarea id="note" name="note" class="form-control" rows="4" placeholder="Thêm ghi chú khi chuyển giao..."></textarea>
                            </div>

                            <!-- Thông tin yêu cầu hỗ trợ -->
                            <div class="form-group mb-4">
                                <label class="font-weight-bold">Yêu cầu hỗ trợ:</label>
                                <div class="p-4 border bg-white rounded">
                                    <p><strong>Tiêu đề:</strong> @supportRequest.RequestTitle</p>
                                    <p><strong>Sản phẩm:</strong> @supportRequest.Product</p>
                                    <p><strong>Chi tiết:</strong> @supportRequest.RequestDetails</p>
                                </div>
                            </div>

                            <input type="hidden" name="id" value="@supportRequest.RequestId" />
                            <input type="hidden" name="RequestId" value="@supportRequest.RequestId" />

                            <div class="text-center mt-4">
                                <button type="submit" class="btn btn-primary px-5 py-2 rounded">Chuyển giao</button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Styles -->
<style>
    h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: bold;
        color: #007bff;
    }

    .list-group-item {
        border: none;
        padding: 10px;
        background-color: #f4f6f9;
        margin-bottom: 10px;
    }

    .card-header {
        font-size: 1.25rem;
        background-color: #007bff;
        color: #fff !important;
    }

    .btn-primary {
        background-color: #007bff;
        color: #fff;
    }

        .btn-primary:hover {
            background-color: #0056b3;
            color: #fff;
        }

    .btn-outline-light {
        border-color: #fff;
        color: #fff;
    }

        .btn-outline-light:hover {
            background-color: #fff;
            color: #007bff;
        }

    .form-group label {
        font-weight: bold;
    }

    .form-control {
        border-radius: 5px;
        padding: 10px;
    }

    .alert-danger, .alert-warning {
        margin-bottom: 15px;
    }
</style>
