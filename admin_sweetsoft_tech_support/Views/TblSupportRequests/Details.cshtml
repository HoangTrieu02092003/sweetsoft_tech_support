@model admin_sweetsoft_tech_support.Models.TblSupportRequest

@{
    ViewData["Title"] = "Details";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

<div class="container mt-4">
    <!-- Tabs -->
    <ul class="nav nav-tabs" id="detailsTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="request-details-tab" data-bs-toggle="tab" data-bs-target="#request-details" type="button" role="tab" aria-controls="request-details" aria-selected="true">
                <i class="bi bi-info-circle"></i> Chi tiết Yêu cầu
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="transfer-history-tab" data-bs-toggle="tab" data-bs-target="#transfer-history" type="button" role="tab" aria-controls="transfer-history" aria-selected="false">
                <i class="bi bi-list"></i> Lịch sử Chuyển giao
            </button>
        </li>
    </ul>

    <!-- Tab content -->
    <div class="tab-content mt-3">
        <!-- Tab: Request Details -->
        <div class="tab-pane fade show active" id="request-details" role="tabpanel" aria-labelledby="request-details-tab">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-warning d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-dark btn-sm">
                        <i class="bi bi-arrow-left"></i> Quay lại danh sách
                    </a>
                    <p class="mb-0 text-center flex-grow-1" style="color: #6a1b9a; font-weight: bold;">
                        <i class="bi bi-info-circle"></i> Thông tin yêu cầu hỗ trợ
                    </p>
                    <a asp-action="Edit" asp-route-id="@Model.RequestId" class="btn btn-warning btn-sm text-dark">
                        <i class="bi bi-pencil-square"></i> Sửa
                    </a>
                </div>

                <div class="card-body">
                    <div class="list-group">
                        <div class="list-group-item bg-light border-0">
                            <strong>Tiêu đề yêu cầu:</strong>
                            <p>@Html.DisplayFor(model => model.RequestTitle)</p>
                        </div>
                        <div class="list-group-item bg-light border-0">
                            <strong>Sản phẩm:</strong>
                            <p>@Html.DisplayFor(model => model.Product)</p>
                        </div>
                        <div class="list-group-item bg-light border-0">
                            <strong>Chi tiết yêu cầu:</strong>
                            <p>@Html.DisplayFor(model => model.RequestDetails)</p>
                        </div>
                        <div class="list-group-item bg-light border-0">
                            <strong>Trạng thái:</strong>
                            <p>
                                @{
                                    string statusText = Model.Status switch
                                    {
                                        0 => "Chưa hoàn thành",
                                        1 => "Hoàn thành",
                                        2 => "Không xử lý được",
                                        _ => "Không xác định"
                                    };
                                }
                                @statusText
                            </p>
                        </div>
                        <div class="list-group-item bg-light border-0">
                            <strong>Khách hàng:</strong>
                            <p>@ViewBag.CustomerName</p>
                        </div>
                        <div class="list-group-item bg-light border-0">
                            <strong>Phòng ban:</strong>
                            <p>@ViewBag.DepartmentName</p>
                        </div>
                        <div class="list-group-item bg-light border-0">
                            <strong>Ngày tạo:</strong>
                            <p>@Model.CreatedAt.ToString("dd/MM/yyyy")</p>
                        </div>
                        <div class="list-group-item bg-light border-0">
                            <strong>Ngày giải quyết:</strong>
                            <p>@(Model.ResolvedAt?.ToString("dd/MM/yyyy") ?? "Chưa giải quyết")</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="tab-pane fade" id="transfer-history" role="tabpanel" aria-labelledby="transfer-history-tab">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-warning d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-dark btn-sm">
                        <i class="bi bi-arrow-left"></i> Quay lại danh sách
                    </a>
                    <p class="mb-0 text-center flex-grow-1" style="color: #6a1b9a; font-weight: bold;">
                        <i class="bi bi-list"></i> Lịch sử Chuyển giao Yêu cầu
                    </p>
                    <a asp-action="Transfer" asp-route-id="@Model.RequestId" class="btn btn-warning btn-sm text-dark">
                        <i class="bi bi-arrow-right-circle"></i> Chuyển giao
                    </a>
                </div>

                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead style="background-color: #ffc107; color: #6a1b9a;">
                            <tr>
                                <th>Từ Phòng ban</th>
                                <th>Đến Phòng ban</th>
                                <th>Người Chuyển giao</th>
                                <th>Thời gian Chuyển giao</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.RequestTransfers != null)
                            {
                                foreach (var transfer in ViewBag.RequestTransfers)
                                {
                                    <tr style="background-color: #f4f6f9;">
                                        <td>@transfer.FromDepartment.DepartmentName</td>
                                        <td>@transfer.ToDepartment.DepartmentName</td>
                                        <td>@transfer.TransferredByNavigation.FullName</td>
                                        <td>@transfer.TransferredAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@transfer.Note</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr style="background-color: #f4f6f9;">
                                    <td colspan="5" class="text-center">Không có lịch sử chuyển giao.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Styles -->
<style>
    h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: bold;
        color: #6a1b9a;
    }

    .list-group-item {
        border: none;
        padding: 10px;
        background-color: #f4f6f9;
        margin-bottom: 10px;
    }

        .list-group-item strong {
            color: #6a1b9a;
        }

    .card-header {
        font-size: 1.25rem;
        background-color: #ffc107;
        color: #6a1b9a !important;
    }

    .btn-warning {
        background-color: #ffc107;
        color: #6a1b9a;
    }

        .btn-warning:hover {
            background-color: #e0a800;
            color: #fff;
        }

    .card-footer {
        background-color: #fff;
        border-top: 1px solid #ddd;
        padding-top: 15px;
    }
</style>
