@model Tuple<List<dynamic>, List<dynamic>>
@{
    ViewData["Title"] = "Nhật ký xử lý yêu cầu";
    var currentId = ViewData["userId"];
    var searchQuery = ViewData["Search"];

    //lấy giá trị phân trang
    var dbPagination = (Pagination)ViewData["DbPagination"];
    var filePagination = (Pagination)ViewData["FilePagination"];
}

<h1>Nhật ký hoạt động</h1>
<!-- Tab navigation -->
<div class="d-flex justify-content-between">
    <div>
        <ul class="nav nav-tabs" id="logTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link active" id="database-tab" data-bs-toggle="tab" href="#database" role="tab" aria-controls="database" aria-selected="true">Từ database</a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" id="file-tab" data-bs-toggle="tab" href="#file" role="tab" aria-controls="file" aria-selected="false">Từ File</a>
            </li>
        </ul>
    </div>
</div>
<div class="tab-content mt-3" id="logTabsContent">
    <!-- Tab 1: Cơ sở dữ liệu -->
    <div class="tab-pane fade show active" id="database" role="tabpanel" aria-labelledby="database-tab">
        <form method="get" class="mb-3">
            <input type="text"
                   name="search"
                   placeholder="Tìm kiếm nội dung"
                   value="@searchQuery"
                   class="form-control d-inline-block w-25 mr-2" />
            <select name="userId" class="form-control d-inline-block w-25 mr-2">
                @if (currentId == null)
                {
                    <option value="" selected>Tất cả</option>
                }
                else
                {
                    <option value="">Tất cả</option>
                }
                @foreach (var user in ViewData["Users"] as IEnumerable<admin_sweetsoft_tech_support.Models.TblUser>)
                {
                    @if (currentId != null && (int)currentId == user.UserId)
                    {
                        <option value="@user.UserId" selected>@user.FullName</option>
                    }
                    else
                    {
                        <option value="@user.UserId">@user.FullName</option>
                    }
                }
            </select>
            <button type="submit" class="btn btn-primary">Lọc</button>
        </form>
            <table class="table">
                <thead>
                    <tr>
                        <th>Người dùng</th>
                        <th>Yêu cầu</th>
                        <th>Hành động</th>
                        <th>Thời gian</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Item1)
                    {
                        <tr>
                            <td>@log.User?.FullName</td>
                            <td>@log.Request?.RequestId</td>
                            <td>@log.Action</td>
                            <td>@log.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <form asp-action="Delete" method="post" style="display: inline;">
                                    <input type="hidden" name="id" value="@log.ActivityId" />
                                    <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        <!-- Phân trang -->
        <div class="d-flex justify-content-center my-4">
            @if (dbPagination.TotalPages > 1)
            {
                <ul class="pagination">
                    @if (ViewData["DbPagination"] != null)
                    {

                        if (dbPagination.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = 1, filePage = filePagination.CurrentPage })">Đầu</a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = dbPagination.CurrentPage - 1, filePage = filePagination.CurrentPage })">Trước</a>
                            </li>
                        }

                        for (int i = 1; i <= dbPagination.TotalPages; i++)
                        {
                            <li class="page-item @(i == dbPagination.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, filePage = filePagination.CurrentPage })">@i</a>
                            </li>
                        }

                        if (dbPagination.CurrentPage < dbPagination.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = dbPagination.CurrentPage + 1, filePage = filePagination.CurrentPage })">Sau</a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = dbPagination.TotalPages, filePage = filePagination.CurrentPage })">Cuối</a>
                            </li>
                        }
                    }
                </ul>
            }
        </div>
    </div>
    <!-- Tab 2: From File -->
    <div class="tab-pane fade" id="file" role="tabpanel" aria-labelledby="file-tab">
        <table class="table table-bordered table-striped mt-4">
            <thead class="thead-dark">
                <tr>
                    <th>Người dùng</th>
                    <th>Yêu cầu</th>
                    <th>Hành động</th>
                    <th>Thời gian</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Item2)
                {
                    <tr>
                        <td>@log.User.FullName</td>
                        <td>@log.Request.RequestId</td>
                        <td>@log.Action</td>
                        <td>@log.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
        <!-- Phân trang -->
        <div class="d-flex justify-content-center my-4">
            @if (filePagination.TotalPages > 1)
            {
                <ul class="pagination">
                    @if (ViewData["FilePagination"] != null)
                    {
                        if (filePagination.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = dbPagination.CurrentPage, filePage = 1, activeTab = "file" })">Đầu</a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = dbPagination.CurrentPage, filePage = filePagination.CurrentPage - 1, activeTab = "file" })">Trước</a>
                            </li>
                        }

                        for (int i = 1; i <= filePagination.TotalPages; i++)
                        {
                            <li class="page-item @(i == filePagination.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = dbPagination.CurrentPage, filePage = i, activeTab = "file" })">@i</a>
                            </li>
                        }

                        if (filePagination.CurrentPage < filePagination.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = dbPagination.CurrentPage, filePage = filePagination.CurrentPage + 1, activeTab = "file" })">Sau</a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = dbPagination.CurrentPage, filePage = filePagination.TotalPages, activeTab = "file" })">Cuối</a>
                            </li>
                        }
                    }
                </ul>
            }
        </div>
    </div>
</div>