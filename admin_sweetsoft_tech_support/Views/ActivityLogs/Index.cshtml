@model Tuple<List<admin_sweetsoft_tech_support.Models.ActivityLogEntry>, List<object>>
@using admin_sweetsoft_tech_support.Attributes
@{
    ViewData["Title"] = "Quản lý Activity Logs";
    int totalPages = (int)ViewData["TotalPages"];
    int currentPage = (int)ViewData["CurrentPage"];
    int stt = 1;
}
<style>
    table tbody tr:nth-child(odd) {
        background-color: #f9f9f9;
    }

    table tbody tr:nth-child(even) {
        background-color: #ffffff;
    }

    .sort-arrow.asc:after {
        content: " ▲";
    }

    .sort-arrow.desc:after {
        content: " ▼";
    }

</style>
<div class="mt-4">
    <h1 class="text-center">Quản lý nhật ký yêu cầu hỗ trợ</h1>

    <!-- Form tìm kiếm -->
    <form method="get" class="m-3" id="filterForm">
        <div class="row">
            <div class="col-md-3">
                @Html.GenerateFilterTextbox(
                         id: "searchTerm",
                         name: "searchTerm",
                         placeholder: "Tìm kiếm ...",
                         value: ViewData["SearchTerm"]?.ToString() ?? "",
                         includeCancelButton: false
                         )
            </div>
            <div class="col-md-3">
                @Html.GenerateFilterDropdown(
                         id: "filterOption",
                         name: "filterOption",
                         options: new Dictionary<string, string>{
                {"day", "Ngày hiện tại"},
                {"month", "Tháng hiện tại"},
                {"year", "Năm hiện tại"}
                },
                         selectedValue: ViewData["FilterOption"]?.ToString() ?? "",
                         includeCancelButton: false
                         )
            </div>
        </div>
    </form>

    <!-- Danh sách Activity Logs -->
    <div class="table-responsive mt-4">
        <table class="table table-striped" id="activityLogList">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>
                        <a href="?sortColumn=Title&sortOrder=@(
                ViewData["SortOrder"] as string == "asc" &&
                ViewData["SortColumn"] as string == "Title" ? "desc" : "asc")">
                            Tiêu đề yêu cầu
                            <span class="sort-arrow @(ViewData["SortColumn"] as string == "Title" ? ViewData["SortOrder"] : "")"></span>
                        </a>
                    </th>
                    <th>
                        <a href="?sortColumn=Action&sortOrder=@(
                ViewData["SortOrder"] as string == "asc" &&
                ViewData["SortColumn"] as string == "Action" ? "desc" : "asc")">
                            Hành động
                            <span class="sort-arrow @(ViewData["SortColumn"] as string == "Action" ? ViewData["SortOrder"] : "")"></span>
                        </a>
                    </th>
                    <th>
                        <a href="?sortColumn=User&sortOrder=@(
                ViewData["SortOrder"] as string == "asc" &&
                ViewData["SortColumn"] as string == "User" ? "desc" : "asc")">
                            Người thực hiện
                            <span class="sort-arrow @(ViewData["SortColumn"] as string == "User" ? ViewData["SortOrder"] : "")"></span>
                        </a>
                    </th>
                    <th>
                        <a href="?sortColumn=Timestamp&sortOrder=@(
                ViewData["SortOrder"] as string == "asc" &&
                ViewData["SortColumn"] as string == "Timestamp" ? "desc" : "asc")">
                            Thời gian
                            <span class="sort-arrow @(ViewData["SortColumn"] as string == "Timestamp" ? ViewData["SortOrder"] : "")"></span>
                        </a>
                    </th>
                    <th class="text-center">
                        Hành động
                    </th>
                </tr>
            </thead>

            <tbody>
                @foreach (var log in Model.Item1)
                {
                    <tr>
                        <td>@stt</td>
                        <td>@log.Title</td>
                        <td>@log.Action</td>
                        <td>@log.User</td>
                        <td>@log.Timestamp.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center">
                            <button type="submit" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#detailModal-@log.Id">
                                <i class="ti ti-eye-check"></i>
                            </button>
                        </td>
                        <div class="modal fade" id="detailModal-@log.Id" tabindex="-1" aria-labelledby="detailModalLabel-@log.Id" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="detailModalLabel-@log.Id">Chi tiết nhật ký</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p><strong>Tiêu đề:</strong> @log.Title</p>
                                        <p><strong>Hành động:</strong> @log.Action</p>
                                        <p><strong>Người thực hiện:</strong> @log.User</p>
                                        <p><strong>Thời gian:</strong> @log.Timestamp.ToString("dd/MM/yyyy HH:mm")</p>
                                        <p><strong>Dữ liệu cũ:</strong> @log.OldValue</p>
                                        <p><strong>Dữ liệu mới:</strong> @log.NewValue</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </tr>                   
                    stt++;
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    <div class="d-flex justify-content-center my-4" id="dbPagination">
        <ul class="pagination">
            @if (totalPages > 1)
            {
                if (currentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { page = 1, date = ViewData["Date"], filterOption = ViewData["FilterOption"], searchTerm = ViewData["SearchTerm"]})"><i class="bi bi-chevron-double-left"></i></a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, date = ViewData["Date"], filterOption = ViewData["FilterOption"], searchTerm = ViewData["SearchTerm"] })"><i class="bi bi-chevron-left"></i></a>
                    </li>
                }
                for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, date = ViewData["Date"], filterOption = ViewData["FilterOption"], searchTerm = ViewData["SearchTerm"] })">@i</a>
                    </li>
                }
                if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, date = ViewData["Date"], filterOption = ViewData["FilterOption"], searchTerm = ViewData["SearchTerm"] })"><i class="bi bi-chevron-right"></i></a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { page = totalPages, date = ViewData["Date"], filterOption = ViewData["FilterOption"], searchTerm = ViewData["SearchTerm"] })"><i class="bi bi-chevron-double-right"></i></a>
                    </li>
                }
            }
        </ul>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    function toggleDetails(timestamp) {
        var detailsRow = document.getElementById('details-' + timestamp);
        if (detailsRow.style.display === 'none') {
            detailsRow.style.display = 'table-row';
        } else {
            detailsRow.style.display = 'none';
        }
    }
</script>
