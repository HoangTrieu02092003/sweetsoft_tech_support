@model admin_sweetsoft_tech_support.Models.TblCustomer

@{
    ViewData["Title"] = "Chỉnh sửa thông tin khách hàng";
    Layout = "~/Views/Shared/_Layout_admin.cshtml";
}

@{
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-error" role="alert">
        @errorMessage
    </div>
}

<style>
    h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: bold;
        color: #6a1b9a;
    }

    .list-group-item {
        border: none;
        padding: 10px;
        background-color: #f4f6f9;
        margin-bottom: 10px;
    }

        .list-group-item strong {
            color: #6a1b9a;
        }

    .card-header {
        font-size: 1.25rem;
        background-color: #ffc107;
        color: #6a1b9a !important;
    }

    .btn-warning {
        background-color: #ffc107;
        color: #6a1b9a;
    }

        .btn-warning:hover {
            background-color: #e0a800;
            color: #fff;
        }

    .btn-outline-dark {
        border-color: #6a1b9a;
        color: #6a1b9a;
    }

        .btn-outline-dark:hover {
            background-color: #6a1b9a;
            color: #fff;
        }

    .card-footer {
        background-color: #fff;
        border-top: 1px solid #ddd;
        padding-top: 15px;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f4f7fc;
        margin: 0;
        padding: 0;
    }

    .container-custom {
        background-color: #ffffff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .section-header {
        background-color: #6a1b9a;
        color: #fff;
        padding: 12px;
        text-align: center;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            font-weight: 600;
            color: #555;
        }

    .form-control {
        border-radius: 8px;
        padding: 12px;
        font-size: 16px;
        border: 1px solid #ccc;
        transition: border-color 0.3s ease;
    }

        .form-control:focus {
            border-color: #6a1b9a;
            box-shadow: 0 0 5px rgba(106, 27, 154, 0.5);
        }

    .btn-back {
        background-color: #e0e0e0;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        color: #333;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        margin-bottom: 20px;
        transition: background-color 0.3s;
    }

        .btn-back:hover {
            background-color: #bdbdbd;
        }

    .btn-submit {
        background-color: #6a1b9a;
        color: white;
        padding: 12px 20px;
        border-radius: 8px;
        border: none;
        font-size: 16px;
        width: 100%;
        transition: background-color 0.3s;
    }

        .btn-submit:hover {
            background-color: #5a1a89;
        }

    .form-group span {
        font-size: 12px;
        color: #d32f2f;
    }

    .d-flex {
        display: flex;
        justify-content: flex-end;
    }

    .table th, .table td {
        text-align: center;
        vertical-align: middle;
    }

    .table-header {
        background-color: #ffc107;
        color: #6a1b9a;
        font-weight: bold;
    }

    .table-row:nth-child(even) {
        background-color: #f8f9fa;
    }

    .nav-tabs {
        border-bottom: 2px solid #6a1b9a;
    }

        .nav-tabs .nav-link {
            color: #6a1b9a;
            font-weight: bold;
            border: 1px solid transparent;
            border-radius: 0;
            transition: all 0.3s ease;
        }

            .nav-tabs .nav-link.active {
                color: #fff;
                background-color: #6a1b9a;
                border-color: #6a1b9a #6a1b9a #fff;
            }

            .nav-tabs .nav-link:hover {
                background-color: #f4f6f9;
                color: #6a1b9a;
            }
</style>

<div class="container">
    <div class="row">
        <div class="col-12 col-md-8 offset-md-2">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-warning d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-dark btn-sm">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <p class="mb-0 text-center flex-grow-1" style="color: #6a1b9a; font-weight: bold;">
                        <i class="bi bi-pencil-square"></i> Chỉnh sửa thông tin khách hàng
                    </p>
                </div>

                <!-- Tabs Navigation -->
                <ul class="nav nav-tabs" id="customerTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab" aria-controls="general" aria-selected="true">
                            Thông tin chung
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="credentials-tab" data-bs-toggle="tab" data-bs-target="#support-requests" type="button" role="tab" aria-controls="support-requests" aria-selected="false">
                            Thống kê yêu cầu
                        </button>
                    </li>
                </ul>

                <!-- Tabs Content -->
                <div class="tab-content" id="customerTabContent">
                    <!-- General Information Tab -->
                    <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab">
                        <div class="card-body">
                            <form asp-action="Edit" method="post">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <input type="hidden" asp-for="CustomerId" />

                                <div class="list-group">
                                    <div class="list-group-item bg-light border-0">
                                        <div class="form-group">
                                            <label asp-for="FullName" class="control-label text-dark">Họ và tên</label>
                                            <input asp-for="FullName" class="form-control" />
                                            <span asp-validation-for="FullName" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="list-group-item bg-light border-0">
                                        <div class="form-group">
                                            <label asp-for="Email" class="control-label text-dark">Email</label>
                                            <input asp-for="Email" class="form-control" />
                                            <span asp-validation-for="Email" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="list-group-item bg-light border-0">
                                        <div class="form-group">
                                            <label asp-for="Phone" class="control-label text-dark">Số điện thoại</label>
                                            <input asp-for="Phone" class="form-control" />
                                            <span asp-validation-for="Phone" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="list-group-item bg-light border-0">
                                        <div class="form-group">
                                            <label asp-for="TaxCode" class="control-label text-dark">Mã số thuế</label>
                                            <input asp-for="TaxCode" class="form-control" />
                                            <span asp-validation-for="TaxCode" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="list-group-item bg-light border-0">
                                        <div class="form-group">
                                            <label asp-for="Company" class="control-label text-dark">Công ty</label>
                                            <input asp-for="Company" class="form-control" />
                                            <span asp-validation-for="Company" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="list-group-item bg-light border-0">
                                        <div class="form-group">
                                            <label asp-for="Status" class="control-label text-dark">Trạng thái</label>
                                            <select asp-for="Status" class="form-control" asp-items="ViewBag.StatusList"></select>
                                            <span asp-validation-for="Status" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="list-group-item bg-light border-0">
                                        <div class="form-group">
                                            <label asp-for="Username" class="control-label text-dark">Tên đăng nhập</label>
                                            <input asp-for="Username" class="form-control" />
                                            <span asp-validation-for="Username" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="list-group-item bg-light border-0" hidden>
                                        <div class="form-group">
                                            <label asp-for="Password" class="control-label text-dark">Mật khẩu</label>
                                            <input asp-for="Password" class="form-control" />
                                            <span asp-validation-for="Password" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="list-group-item bg-light border-0">
                                        <div class="form-group">
                                            <label asp-for="CreatedBy" class="control-label text-dark">Người tạo</label>
                                            <select asp-for="CreatedBy" class="form-control" asp-items="ViewBag.CreatedUser" disabled></select>
                                            <span asp-validation-for="CreatedBy" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="list-group-item bg-light border-0">
                                        <div class="form-group">
                                            <label asp-for="CreatedAt" class="control-label text-dark">Ngày tạo</label>
                                            <input type="text" class="form-control" readonly
                                                   value="@Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm:ss")" />
                                        </div>
                                    </div>

                                    <div class="list-group-item bg-light border-0">
                                        <div class="form-group" >
                                            <label asp-for="UpdatedBy" class="control-label text-dark">Người cập nhật</label>
                                            <select asp-for="UpdatedBy" class="form-control" asp-items="ViewBag.UpdatedUser" disabled></select>
                                            <span asp-validation-for="UpdatedBy" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="list-group-item bg-light border-0">
                                        <div class="form-group">
                                            <label asp-for="UpdatedAt" class="control-label text-dark">Ngày cập nhật</label>
                                            <input type="text" class="form-control" readonly
                                                   value="@Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm:ss")" />
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group mt-3">
                                    <input type="submit" value="Lưu" class="btn btn-warning w-100" />
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Support Requests Tab -->
                    <div class="tab-pane fade" id="support-requests" role="tabpanel" aria-labelledby="support-requests-tab">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead class="table-header">
                                        <tr>
                                            <th>Tên phòng ban</th>
                                            <th>Vấn đề</th>
                                            <th>Trạng thái</th>
                                            <th>Ngày tạo</th>
                                            <th>Ngày hoàn thành</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var request in Model.TblSupportRequests)
                                        {
                                            <tr class="table-row">
                                                <td>@request.Department?.DepartmentName</td>
                                                <td>@request.RequestDetails</td>
                                                <td>@(request.Status == 1 ? "Đã xử lý" : request.Status == 0 ? "Chưa xử lý": request.Status == 2 ? "Không xử lý được" : "Không xác định")</td>
                                                <td>@request.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                                <td>@(request.ResolvedAt.HasValue ? request.ResolvedAt.Value.ToString("dd/MM/yyyy HH:mm:ss") : "N/A")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
