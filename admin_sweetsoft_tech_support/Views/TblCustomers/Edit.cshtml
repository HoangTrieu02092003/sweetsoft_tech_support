@model admin_sweetsoft_tech_support.Models.TblCustomer

@{
    ViewData["Title"] = "Chỉnh sửa thông tin khách hàng";
    Layout = "~/Views/Shared/_Layout_admin.cshtml";
}

<style>

    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f4f7fc;
        margin: 0;
        padding: 0;
    }

    .container-custom {
        background-color: #ffffff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    h1 {
        font-size: 28px;
        color: #333;
        font-weight: 600;
        margin-bottom: 20px;
        text-align: center;
    }

    .section-header {
        background-color: #6a1b9a;
        color: #fff;
        padding: 12px;
        text-align: center;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            font-weight: 600;
            color: #555;
        }

    .form-control {
        border-radius: 8px;
        padding: 12px;
        font-size: 16px;
        border: 1px solid #ccc;
        transition: border-color 0.3s ease;
    }

        .form-control:focus {
            border-color: #6a1b9a;
            box-shadow: 0 0 5px rgba(106, 27, 154, 0.5);
        }

    .btn-back {
        background-color: #e0e0e0;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        color: #333;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        margin-bottom: 20px;
        transition: background-color 0.3s;
    }

        .btn-back:hover {
            background-color: #bdbdbd;
        }

    .btn-submit {
        background-color: #6a1b9a;
        color: white;
        padding: 12px 20px;
        border-radius: 8px;
        border: none;
        font-size: 16px;
        width: 100%;
        transition: background-color 0.3s;
    }

        .btn-submit:hover {
            background-color: #5a1a89;
        }

    .form-group span {
        font-size: 12px;
        color: #d32f2f;
    }

    .d-flex {
        display: flex;
        justify-content: flex-end;
    }

    .table th, .table td {
        text-align: center;
        vertical-align: middle; /* Căn giữa theo chiều dọc */
    }

</style>

<div class="container w-100 d-flex justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="container-custom">
            <div class="section-header">
                <h1 class="text-white">Thông tin khách hàng</h1>
            </div>

            <div class="d-flex justify-content-end">
                <a asp-action="Index" class="btn btn-back">
                    <i></i> Quay lại
                </a>
            </div>

            <!-- Tabs Navigation -->
            <ul class="nav nav-tabs" id="customerTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab" aria-controls="general" aria-selected="true">
                        Thông tin chung
                    </button>
                </li>
                
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="credentials-tab" data-bs-toggle="tab" data-bs-target="#support-requests" type="button" role="tab" aria-controls="support-requests" aria-selected="false">
                        Thống kê yêu cầu
                    </button>
                </li>
            </ul>

            <!-- Tabs Content -->
            <div class="tab-content" id="customerTabContent">
                <!-- General Information Tab -->
                <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="CustomerId" />

                        <div class="form-group">
                            <label asp-for="FullName" class="control-label">Họ và tên</label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Email" class="control-label">Email</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Phone" class="control-label">Số điện thoại</label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="TaxCode" class="control-label">Mã số thuế</label>
                            <input asp-for="TaxCode" class="form-control" />
                            <span asp-validation-for="TaxCode" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Company" class="control-label">Công ty</label>
                            <input asp-for="Company" class="form-control" />
                            <span asp-validation-for="Company" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Product" class="control-label">Sản phẩm</label>
                            <input asp-for="Product" class="form-control" />
                            <span asp-validation-for="Product" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Username" class="control-label">Tên đăng nhập</label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Password" class="control-label">Mật khẩu</label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="ResetToken" class="control-label">Token đặt lại</label>
                            <input asp-for="ResetToken" class="form-control" />
                            <span asp-validation-for="ResetToken" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="ResetTokenExpiry" class="control-label">Hết hạn token đặt lại</label>
                            <input asp-for="ResetTokenExpiry" class="form-control" />
                            <span asp-validation-for="ResetTokenExpiry" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Token" class="control-label">Token</label>
                            <input asp-for="Token" class="form-control" />
                            <span asp-validation-for="Token" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="TokenExpiry" class="control-label">Hết hạn token</label>
                            <input asp-for="TokenExpiry" class="form-control" />
                            <span asp-validation-for="TokenExpiry" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CreatedUser" class="control-label">Người tạo</label>
                            <select asp-for="CreatedUser" class="form-control" asp-items="ViewBag.CreatedUser"></select>
                            <span asp-validation-for="CreatedUser" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="CreatedAt" class="control-label">Ngày tạo</label>
                            <input asp-for="CreatedAt" class="form-control" />
                            <span asp-validation-for="CreatedAt" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="UpdatedUser" class="control-label">Người cập nhật</label>
                            <select asp-for="UpdatedUser" class="form-control" asp-items="ViewBag.UpdatedUser"></select>
                            <span asp-validation-for="UpdatedUser" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="UpdatedAt" class="control-label">Ngày cập nhật</label>
                            <input asp-for="UpdatedAt" class="form-control" />
                            <span asp-validation-for="UpdatedAt" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <input type="submit" value="Lưu" class="btn btn-submit" />
                        </div>


                    </form>
                </div>

                <!-- Credentials Tab -->
                <div class="tab-pane fade" id="support-requests" role="tabpanel" aria-labelledby="support-requests-tab">
                    <form asp-action="Edit" method="post">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Mã khách hàng</th>
                                        <th>Mã phòng ban</th>
                                        <th>Vấn đề</th>
                                        <th>Trạng thái</th>
                                        <th>Ngày tạo</th>
                                        <th>Ngày hoàn thành</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.TblSupportRequests)
                                    {
                                        <tr>
                                            <td>@request.CustomerId</td>
                                            <td>@request.DepartmentId</td>
                                            <td>@request.RequestDetails</td>
                                            <td>
                                                @(request.Status == 1 ? "Đã xử lý" : "Chưa xử lý")
                                            </td>
                                            <td>@request.CreatedAt.ToString("yyyy-MM-dd HH")</td>
                                            <td>@(request.ResolvedAt.HasValue ? request.ResolvedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") : "N/A")</td>
                                        </tr>
                                    }
                                   
                                </tbody>
                            </table>
                        </div>
                    </form>
                </div>

               
            </div>
        </div>
    </div>
</div>
