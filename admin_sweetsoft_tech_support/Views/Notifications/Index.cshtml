@model List<admin_sweetsoft_tech_support.Models.NotificationEntry>
@using admin_sweetsoft_tech_support.Attributes
@{
    ViewData["Title"] = "Quản lý Thông báo";
    int totalPages = (int)ViewData["TotalPages"];
    int currentPage = (int)ViewData["CurrentPage"];
    int stt = 1;

}
<style>
    table tbody tr:nth-child(odd) {
        background-color: #f9f9f9;
    }

    table tbody tr:nth-child(even) {
        background-color: #ffffff;
    }

</style>
<div class="mt-4">
    <h1 class="text-center">Quản lý thông báo</h1>

    <!-- Form tìm kiếm -->
    <form method="get" class="m-3" id="filterForm">
        <div class="row">
            <div class="col-md-3">
                @Html.GenerateFilterTextbox(
                         id: "searchTerm",
                         name: "searchTerm",
                         placeholder: "Tìm kiếm......",
                         value: ViewData["SearchTerm"]?.ToString() ?? "",
                         includeCancelButton: false
                         )
            </div>
            <div class="col-md-3">
                @Html.GenerateFilterDropdown(
                         id: "filterOption",
                         name: "filterOption",
                         options: new Dictionary<string, string>{
                {"day", "Ngày"},
                {"month", "Tháng"},
                {"year", "Năm"}
                },
                         selectedValue: ViewData["FilterOption"]?.ToString() ?? "",
                         includeCancelButton: false
                         )
            </div>
        </div>
    </form>

    <!-- Danh sách Audit Logs -->
    <div class="table-responsive mt-4">
        <table class="table table-striped" id="auditLogList">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Người nhận</th>
                    <th>Nội dung</th>
                    <th>Trạng thái</th>
                    <th>Thời gian</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>@stt</td>
                        <td>@log.User</td>
                        <td>@log.Content</td>
                        <td>@log.Status</td>
                        <td>@log.Timestamp</td>
                        <td>
                            <button class="btn btn-sm btn-info" onclick="toggleDetails('@log.Timestamp')">
                                Xem
                            </button>
                        </td>
                    </tr>
                    <tr id="details-@log.Timestamp" class="details-row" style="display: none;">
                        <td colspan="6">
                            <strong>Chi tiết:</strong><br />
                            <ul>
                                <!-- Add other details here -->
                            </ul>
                        </td>
                    </tr>
                    stt++;
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    <div class="d-flex justify-content-center my-4" id="dbPagination">
        <ul class="pagination">
            @if (totalPages > 1)
            {
                if (currentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { page = 1, date = ViewData["Date"] })"><i class="bi bi-chevron-double-left"></i></a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, date = ViewData["Date"] })"><i class="bi bi-chevron-left"></i></a>
                    </li>
                }
                for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, date = ViewData["Date"] })">@i</a>
                    </li>
                }
                if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, date = ViewData["Date"] })"><i class="bi bi-chevron-right"></i></a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { page = totalPages, date = ViewData["Date"] })"><i class="bi bi-chevron-double-right"></i></a>
                    </li>
                }
            }
        </ul>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    function toggleDetails(timestamp) {
        var detailsRow = document.getElementById('details-' + timestamp);
        if (detailsRow.style.display === 'none') {
            detailsRow.style.display = 'table-row';
        } else {
            detailsRow.style.display = 'none';
        }
    }
</script>