@model IEnumerable<admin_sweetsoft_tech_support.Models.NotificationEntry>

@{
    ViewData["Title"] = "Thông báo của tôi";
    int stt = 1;
}

<h1 class="text-center">Thông báo của tôi</h1>

@if (!Model.Any())
{
    <p>Không có thông báo nào.</p>
}
else
{
    <div class="table-responsive mt-4">
        <table class="table table-striped" id="notificationList">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Người nhận</th>
                    <th>Nội dung</th>
                    <th>Thời gian</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var notification in Model)
                {
                    <tr >
                        <td>@stt</td>
                        <td>@notification.User</td>
                        <td>@notification.Content</td>
                        <td>@notification.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    </tr>
                    stt++;
                    <!-- Tăng số thứ tự -->
                }
            </tbody>
        </table>
    </div>
}

<!-- Phân trang nếu có -->
<div class="pagination mt-3">
    @if (ViewData["TotalPages"] != null)
    {
        var totalPages = (int)ViewData["TotalPages"];
        var currentPage = (int)ViewData["CurrentPage"];
        <ul class="pagination">
            @for (var i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("MyNotifications", new { page = i })">@i</a>
                </li>
            }
        </ul>
    }
</div>