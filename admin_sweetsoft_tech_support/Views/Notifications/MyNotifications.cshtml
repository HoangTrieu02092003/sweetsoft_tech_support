@model IEnumerable<admin_sweetsoft_tech_support.Models.TblNotification>

@{
    ViewData["Title"] = "Thông báo của tôi";
}
<style>
    .bold-text{
        font-weight: bold;
    }
</style>
<h1>Thông báo của tôi</h1>

@if (!Model.Any())
{
    <p>Không có thông báo nào.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    <a href="?sortColumn=Message&sortOrder=@(
                        ViewData["SortOrder"] as string == "asc" && 
                        ViewData["SortColumn"] as string == "Message" ? "desc" : "asc")">
                        Nội dung
                    </a>
                </th>
                <th>
                    <a href="?sortColumn=Status&sortOrder=@(
                        ViewData["SortOrder"] as string == "asc" && 
                        ViewData["SortColumn"] as string == "Status" ? "desc" : "asc")">
                        Trạng thái
                    </a>
                </th>
                <th>
                    <a href="?sortColumn=CreatedAt&sortOrder=@(
                        ViewData["SortOrder"] as string == "asc" && 
                        ViewData["SortColumn"] as string == "CreatedAt" ? "desc" : "asc")">
                        Thời gian
                    </a>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var notification in Model)
            {
                <tr class="@(notification.Status == 0 ? "bold-text" : "")"
                    style="cursor: pointer;"
                    onclick="window.location.href='@Url.Action("Index", "TblSupportRequests")'">
                    <td>@notification.Message</td> 
                    <td>@(notification.Status == 0 ? "Chưa đọc" : "Đã đọc")</td> 
                    <td>@notification.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</td> 
                </tr>
            }
        </tbody>
    </table>
}