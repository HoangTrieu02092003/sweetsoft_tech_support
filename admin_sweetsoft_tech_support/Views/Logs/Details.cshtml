@model TblLog
@{
    ViewData["Title"] = "Chi tiết Log";
}

<div class="container mt-4">
    <h1 class="text-center">Chi tiết Nhật ký</h1>

    <table class="table table-bordered mt-4">
        <tr>
            <th>ID</th>
            <td>@Model.LogId</td>
        </tr>
        <tr>
            <th>User ID</th>
            <td>@Model.UserId</td>
        </tr>
        <tr>
            <th>Action</th>
            <td>@Model.Action</td>
        </tr>
        <tr>
            <th>Mô tả</th>
            <td>@Model.Description</td>
        </tr>
        <tr>
            <th>Thời gian</th>
            <td>@Model.CreatedAt?.ToString("dd/MM/yyyy")</td>
        </tr>
    </table>
    <a href="@Url.Action("Index", "Logs")" class="btn btn-secondary">Quay lại</a>
</div>