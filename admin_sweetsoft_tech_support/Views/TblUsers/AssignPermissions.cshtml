@model int
@{
    ViewBag.Title = "Cấp quyền cho người dùng";

    var createPer = ViewBag.CreatePer as List<admin_sweetsoft_tech_support.Models.TblPermission>;
    var editPer = ViewBag.EditPer as List<admin_sweetsoft_tech_support.Models.TblPermission>;
    var deletePer = ViewBag.DeletePer as List<admin_sweetsoft_tech_support.Models.TblPermission>;
    var ortherPer = ViewBag.OtherPer as List<admin_sweetsoft_tech_support.Models.TblPermission>;
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="~/css/assignPermission.css" rel="stylesheet">
<h3 class="text-center">Cấp quyền cho @ViewBag.UserName</h3>

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="AssignPermissions">
                <input type="hidden" name="userId" value="@Model" />

                <!-- Yêu cầu -->
                <div class="form-group mb-4">
                    <a class="btn" style="color: #6a1b9a;" data-bs-toggle="collapse" data-bs-target="#createSection" aria-expanded="false" aria-controls="requestPermissionsSection">
                        Thêm <i class="bi bi-plus"></i>
                    </a>
                    <div id="createSection" class="collapse mt-2">
                        <div class="row">
                            @foreach (var permission in createPer!)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="form-check m-2">
                                        <input class="form-check-input" type="checkbox"
                                               name="selectedPermissions"
                                               value="@permission.PermissionId"
                                        @(ViewBag.AssignedPermissions.Contains(permission.PermissionId) ? "checked" : "") />
                                        <label class="form-check-label">@permission.PermissionName</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Quản lý -->
                <div class="form-group mb-4">
                    <a class="btn" style="color: #6a1b9a;" data-bs-toggle="collapse" data-bs-target="#editSection" aria-expanded="false" aria-controls="managementPermissionsSection">
                        Sửa <i class="bi bi-plus"></i>
                    </a>
                    <div id="editSection" class="collapse mt-2">
                        <div class="row">
                            @foreach (var permission in editPer!)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="form-check m-2">
                                        <input class="form-check-input" type="checkbox"
                                               name="selectedPermissions"
                                               value="@permission.PermissionId"
                                        @(ViewBag.AssignedPermissions.Contains(permission.PermissionId) ? "checked" : "") />
                                        <label class="form-check-label">@permission.PermissionName</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                @* xóa *@
                <div class="form-group mb-4">
                    <a class="btn" style="color: #6a1b9a;" data-bs-toggle="collapse" data-bs-target="#deleteSection" aria-expanded="false" aria-controls="managementPermissionsSection">
                        Xóa <i class="bi bi-plus"></i>
                    </a>
                    <div id="deleteSection" class="collapse mt-2">
                        <div class="row">
                            @foreach (var permission in deletePer!)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="form-check m-2">
                                        <input class="form-check-input" type="checkbox"
                                               name="selectedPermissions"
                                               value="@permission.PermissionId"
                                        @(ViewBag.AssignedPermissions.Contains(permission.PermissionId) ? "checked" : "") />
                                        <label class="form-check-label">@permission.PermissionName</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                @* khác *@
                <div class="form-group mb-4">
                    <a class="btn" style="color: #6a1b9a;" data-bs-toggle="collapse" data-bs-target="#ortherSection" aria-expanded="false" aria-controls="managementPermissionsSection">
                        Khác <i class="bi bi-plus"></i>
                    </a>
                    <div id="ortherSection" class="collapse mt-2">
                        <div class="row">
                            @foreach (var permission in ortherPer!)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="form-check m-2">
                                        <input class="form-check-input" type="checkbox"
                                               name="selectedPermissions"
                                               value="@permission.PermissionId"
                                        @(ViewBag.AssignedPermissions.Contains(permission.PermissionId) ? "checked" : "") />
                                        <label class="form-check-label">@permission.PermissionName</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="d-flex">
                    <a asp-action="Index" class="btn btn-outline-dark m-2" style="width:20%;">Quay lại</a>
                    <button type="submit" class="btn btn-warning m-2 w-100">Cấp quyền</button>
                </div>
            </form>

        </div>
    </div>
</div>