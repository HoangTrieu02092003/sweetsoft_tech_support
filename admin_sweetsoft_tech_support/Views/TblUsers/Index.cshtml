@model IEnumerable<admin_sweetsoft_tech_support.Models.TblUser>

@{
    ViewData["Title"] = "Index";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
<link href="~/css/index_user.css" rel="stylesheet">
<style>
    .email-content {
        max-width: 150px; /* Giới hạn chiều rộng của email */
        white-space: nowrap; /* Không xuống dòng */
        overflow: hidden; /* Ẩn phần vượt quá */
        text-overflow: ellipsis; /* Thêm dấu ba chấm */
    }
    th {
        white-space: nowrap; /* Đảm bảo tiêu đề không bị xuống dòng */
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-0">
    <h1 class=" my-4" style="color: #6a1b9a; font-size: 24px;">Quản lý Người dùng</h1>
    <a asp-action="Create" class="btn btn-warning text-dark">
        <i class="bi bi-plus-circle"></i> Tạo mới
    </a>
</div>

<form method="get" class="m-3" id="filterForm">
    <div class="row">
        <div class="col-md-3">
            <label for="Status" class="form-label">Trạng thái</label>
            <select id="Status" name="Status" class="form-select" onchange="submitForm()">

                @if (ViewData["Status"] == null)
                {
                    <option value="" selected>Tất cả</option>
                }
                else
                {
                    <option value="">Tất cả</option>
                }
                @if (ViewData["Status"] != null && (int)ViewData["Status"] == 1)
                {
                    <option value="1" selected>Hoạt động</option>
                }
                else
                {
                    <option value="1">Hoạt động</option>
                }
                @if (ViewData["Status"] != null && (int)ViewData["Status"] == 0)
                {
                    <option value="0" selected>Ngừng hoạt động</option>
                }
                else
                {
                    <option value="0">Ngừng hoạt động</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label for="Role" class="form-label">Nhóm quyền</label>
            <select id="Role" name="Role" class="form-select" onchange="submitForm()">
                <option value="">Tất cả</option>
                @foreach (var role in ViewBag.Roles)
                {
                    if (ViewData["Role"] != null && (int)ViewData["Role"] == role.RoleId)
                    {
                        <option value="@role.RoleId" selected>@role.RoleName</option>
                    }
                    else
                    {
                        <option value="@role.RoleId">@role.RoleName</option>
                    }
                }
            </select>
        </div>
    </div>
</form>

<!-- Table to display the users -->
<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Tên người dùng</th>
                <th>Email</th>
                <th>Số điện thoại</th>
                <th>Trạng thái</th>
                <th>Phòng ban</th>
                <th>Nhóm quyền</th>
                <th>Đăng nhập lần cuối</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td class="email-content">@item.Email</td>
                    <td>@item.Phone</td>
                    <td>
                        <span class="badge @((item.Status == 1) ? "bg-success" : "bg-danger")">
                            @(item.Status == 1 ? "Hoạt động" : "Ngừng hoạt động")
                        </span>
                    </td>
                    <td>@item.Department.DepartmentName</td>
                    <td>@item.Role!.RoleName</td>
                    <td>@(item.LastLogin?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-action="AssignPermissions" asp-route-id="@item.UserId" class="btn btn-outline-info btn-sm">
                            <i class="bi bi-gear"></i>
                        </a>
                        <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.UserId">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Xác Nhận Xóa -->
@foreach (var item in Model)
{
    <div class="modal fade" id="deleteModal-@item.UserId" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Xác nhận xóa người dùng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Bạn có chắc chắn muốn xóa người dùng này không?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <form method="post" asp-action="Delete" asp-route-id="@item.UserId">
                        <button type="submit" class="btn btn-danger">Xóa</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- Pagination -->
<div class="d-flex justify-content-center my-4">
    <ul class="pagination">
        @if (ViewData["CurrentPage"] != null && (int)ViewData["CurrentPage"] > 1)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = 1, status = ViewBag.Status, role = ViewBag.Role })">Đầu</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["CurrentPage"] - 1, status = ViewBag.Status, role = ViewBag.Role })">Trước</a>
            </li>
        }

        @if (ViewData["TotalPages"] != null)
        {
            int totalPages = (int)ViewData["TotalPages"];
            for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == (int)ViewData["CurrentPage"] ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = i, status = ViewBag.Status, role = ViewBag.Role })">@i</a>
                </li>
            }
        }

        @if (ViewData["CurrentPage"] != null && (int)ViewData["CurrentPage"] < (int)ViewData["TotalPages"])
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["CurrentPage"] + 1, status = ViewBag.Status, role = ViewBag.Role })">Sau</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["TotalPages"], status = ViewBag.Status, role = ViewBag.Role })">Cuối</a>
            </li>
        }
    </ul>
</div>

<script>
    function submitForm() {
        document.getElementById('filterForm').submit();
    }
</script>
