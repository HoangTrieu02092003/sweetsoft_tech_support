@model IEnumerable<admin_sweetsoft_tech_support.Models.TblUser>
@using admin_sweetsoft_tech_support.Attributes
@{
    ViewData["Title"] = "Quản Lý Nhân Viên";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<link href="~/css/index_user.css" rel="stylesheet">
<style>
    .email-content {
        max-width: 150px; /* Giới hạn chiều rộng của email */
        white-space: nowrap; /* Không xuống dòng */
        overflow: hidden; /* Ẩn phần vượt quá */
        text-overflow: ellipsis; /* Thêm dấu ba chấm */
    }
    th {
        white-space: nowrap; /* Đảm bảo tiêu đề không bị xuống dòng */
    }

    .input-fillter-container {
        position: relative;
        display: inline-block;
    }

    .input-fillter-container button {
        position: absolute;
        right: -30px; /* Đặt nút ở bên phải */
        top: 50%;
        transform: translateY(-50%); /* Canh giữa theo chiều dọc */
        border: none;
        cursor: pointer;
        font-size: 16px;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-0">
    <h1 class=" my-4" style="color: #6a1b9a; font-size: 24px;">Quản lý Người dùng</h1>
    <a asp-action="Create" class="btn btn-warning text-dark">
        <i class="bi bi-plus-circle"></i> Tạo mới
    </a>
</div>

<form method="get" class="m-3" id="filterForm">
    <div class="row">
        <h5 class="">
            Bộ tìm kiếm
        </h5>
        <div class="col-lg-3 col-md-8">

            @Html.GenerateFilterDropdown(
                     id: "Status",
                     name: "Status",
                     options: new Dictionary<string, string>
                    {
                        {"1", "Hoạt động"},
                        {"0", "Ngừng hoạt động"}
                    },
                    placeholder: "-- Trạng thái --",
                    selectedValue: ViewData["status"]?.ToString() ?? "",
                    includeCancelButton: false
            )
        </div>
        <div class="col-lg-3 col-md-8">
            @Html.GenerateFilterTextbox(
                     id: "search",
                     name: "Search",
                     placeholder: "Tìm kiếm......",
                     value: ViewData["Search"]?.ToString() ?? "",
                     includeCancelButton: false
                     )
        </div>
        <div class="d-lg-none d-block mt-3">
            <button type="submit" class="btn btn-primary w-100">Lọc</button>
        </div>
    </div>
</form>


<!-- Table to display the users -->
<div class="table-responsive table-responsive-custom">
    <table class="table table-striped custom-table">
        <thead>
            <tr>
                <th>STT</th>
                <th class="custom-header">
                    <a href="?sortColumn=FullName&sortOrder=@(
                ViewData["SortOrder"] as string == "asc" &&
                ViewData["SortColumn"] as string == "FullName" ? "desc" : "asc")">
                        Tên người dùng
                        <span class="sort-arrow @(ViewData["SortColumn"] as string == "FullName" ? ViewData["SortOrder"] : "")"></span>
                    </a>
                </th>
                <th>
                    <a href="?sortColumn=Email&sortOrder=@(
                ViewData["SortOrder"] as string == "asc" &&
                ViewData["SortColumn"] as string == "Email" ? "desc" : "asc")">
                        Email
                        <span class="sort-arrow @(ViewData["SortColumn"] as string == "Email" ? ViewData["SortOrder"] : "")"></span>
                    </a>
                </th>
                <th>Số điện thoại</th>
                <th>
                    <a href="?sortColumn=Status&sortOrder=@(
                ViewData["SortOrder"] as string == "asc" &&
                ViewData["SortColumn"] as string == "Status" ? "desc" : "asc")">
                        Trạng thái
                        <span class="sort-arrow @(ViewData["SortColumn"] as string == "Status" ? ViewData["SortOrder"] : "")"></span>
                    </a>
                </th>
                <th>Phòng ban</th>
                <th>Nhóm quyền</th>
                <th>
                    <a href="?sortColumn=LastLogin&sortOrder=@(
                ViewData["SortOrder"] as string == "asc" &&
                ViewData["SortColumn"] as string == "LastLogin" ? "desc" : "asc")">
                        Đăng nhập lần cuối
                        <span class="sort-arrow @(ViewData["SortColumn"] as string == "LastLogin" ? ViewData["SortOrder"] : "")"></span>
                    </a>
                </th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count(); i++)
            {
                var item = Model.ElementAt(i);
                <tr>
                    <td class="text-center">@((ViewData["CurrentPage"] != null ? ((int)ViewData["CurrentPage"] - 1) * 6 + (i + 1) : i + 1))</td>
                    <td>@item.FullName</td>
                    <td class="email-content">@item.Email</td>
                    <td>@item.Phone</td>
                    <td class="text-center">
                        <span class="badge @((item.Status == 1) ? "bg-success" : "bg-danger")">
                            @(item.Status == 1 ? "Hoạt động" : "Ngừng hoạt động")
                        </span>
                    </td>
                    <td>@item.Department.DepartmentName</td>
                    <td>@item.Role!.RoleName</td>
                    <td>@(item.LastLogin?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-action="AssignPermissions" asp-route-id="@item.UserId" class="btn btn-outline-info btn-sm">
                            <i class="bi bi-gear"></i>
                        </a>
                        <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.UserId">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


<!-- Modal Xác Nhận Xóa -->
@foreach (var item in Model)
{
    <div class="modal fade" id="deleteModal-@item.UserId" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Xác nhận xóa người dùng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Bạn có chắc chắn muốn xóa người dùng này không?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <form method="post" asp-action="Delete" asp-route-id="@item.UserId">
                        <button type="submit" class="btn btn-danger">Xóa</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- Pagination -->
<div class="d-flex justify-content-center my-4">
    <ul class="pagination">
        @if (ViewData["CurrentPage"] != null && (int)ViewData["CurrentPage"] > 1)
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = 1, status = ViewBag.Status, search = ViewBag.search, sortColumn = ViewData["SortColumn"], sortOrder = ViewData["SortOrder"] })">
                    <i class="bi bi-chevron-double-left"></i>
                </a>
            </li>
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["CurrentPage"] - 1, status = ViewBag.Status, search = ViewBag.search, sortColumn = ViewData["SortColumn"], sortOrder = ViewData["SortOrder"] })">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
        }

        @if (ViewData["TotalPages"] != null)
        {
            int totalPages = (int)ViewData["TotalPages"];
            for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == (int)ViewData["CurrentPage"] ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = i, Status = ViewData["Status"], search = ViewBag.search, sortColumn = ViewData["SortColumn"], sortOrder = ViewData["SortOrder"] })">@i</a>
                </li>
            }
        }

        @if (ViewData["CurrentPage"] != null && (int)ViewData["CurrentPage"] < (int)ViewData["TotalPages"])
        {
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["CurrentPage"] + 1, status = ViewBag.Status, search = ViewBag.search, sortColumn = ViewData["SortColumn"], sortOrder = ViewData["SortOrder"] })">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
            <li class="page-item">
                <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["TotalPages"], status = ViewBag.Status, search = ViewBag.search, sortColumn = ViewData["SortColumn"], sortOrder = ViewData["SortOrder"] })">
                    <i class="bi bi-chevron-double-right"></i>
                </a>
            </li>
        }
    </ul>
</div>
