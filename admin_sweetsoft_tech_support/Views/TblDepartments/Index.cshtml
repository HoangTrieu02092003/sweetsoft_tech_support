@model IEnumerable<admin_sweetsoft_tech_support.Models.TblDepartment>
@using admin_sweetsoft_tech_support.Attributes
@{
    ViewData["Title"] = "Quản lý Phòng Ban";
    int stt = 1;
}

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        .header {
        color: #6a1b9a;
        font-size: 24px;
        font-weight: bold;
        }

        /* Responsive design adjustments */
        @@media (max-width: 576px) {
        .action-btn

        {
        padding: 5px;
        text-align: center;
        display: flex;
        justify-content: center;
        align-items: center;
        }


        .action-text {
        display: none; /* Ẩn văn bản trên nút khi thu nhỏ */
        }

        .btn-group .btn {
        width: 35px; /* Giảm kích thước nút */
        height: 35px;
        font-size: 1rem;
        }

        }

        .header {
        color: #6a1b9a;
        }

        .table {
        font-size: 0.9rem; /* Điều chỉnh kích thước chữ */
        }
        th {
        white-space:nowrap;
        }
    </style>
</head>
<body>
    <!-- Hiển thị thông báo -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @{
        var searchName = ViewData["SearchName"] as string ?? "";
        var searchStatus = ViewData["SearchStatus"] as int?;
        var sortOrder = ViewData["SortOrder"] as string ?? "name";
    }
    <script>
        // Tự động ẩn thông báo sau 5 giây
        setTimeout(() => {
        const alerts = document.querySelectorAll('.alert');
        alerts.forEach(alert => {
        alert.classList.remove('show'); // Ẩn alert
        alert.addEventListener('transitionend', () => alert.remove()); // Loại bỏ khỏi DOM sau khi ẩn
        });
        }, 5000); // 5000ms = 5 giây
    </script>
    <div class="d-flex justify-content-between">
        <div class="header">
            <p>Danh sách phòng ban</p>
        </div>

        <div>
            <a class="btn-create btn btn-warning" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="bi bi-plus-circle"></i> 
                <span class="d-lg-inline-block d-none">Tạo mới</span>
            </a>
        </div>
    </div>

    <div class="mb-4">
        <!-- Form tìm kiếm -->
        <form method="get" class="row g-2">
            <div class="col-md-3">
                @Html.GenerateFilterTextbox(
                             id: "search",
                             name: "search",
                             includeCancelButton:false,
                             value: ViewData["search"]?.ToString()??""
                         )
            </div>
            <div class="col-md-3">
                @Html.GenerateFilterDropdown(
                                     id: "status",
                                     name: "status",
                                     includeCancelButton: false,
                                     options: new Dictionary<string, string> {
                            {"0","Tạm dừng"},
                            {"1","Hoạt động"}
                        },
                                     selectedValue: ViewData["status"]?.ToString() ?? ""
                                     )
            </div>
            <div class="mt-2 text-end">
                <button type="submit" class="btn btn-info d-block d-md-none"><i class="bi bi-search"></i> Tìm kiếm</button>
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Tên phòng ban</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Số lượng thành viên</th>
                    <th class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@stt</td>
                        <td>@Html.DisplayFor(modelItem => item.DepartmentName)</td>
                        <td class="text-center">
                            <span class="badge @(item.Status == 1 ? "bg-success" : "bg-danger")">
                                @(item.Status == 1 ? "Hoạt động" : "Tạm dừng")
                            </span>
                        </td>
                        <td class ="text-center">@ViewBag.MemberCounts[item.DepartmentId]</td>
                        <td class="text-center">
                            <div>
                                <a class="btn btn-outline-info btn-sm" asp-action="Edit" asp-route-id="@item.DepartmentId">
                                    <i class="bi bi-pencil-square"></i>
                                    <span class="action-text"></span>
                                </a>
                                <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.DepartmentId">
                                    <i class="bi bi-trash"></i>
                                    <span class="action-text"></span>
                                </button>
                            </div>
                        </td>
                    </tr>
                    stt++;
                    <!-- Modal delete -->
                    <div class="modal fade" id="deleteModal-@item.DepartmentId" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h3 class="modal-title" id="deleteModalLabel">Xóa phòng ban</h3>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    Bạn có muốn xóa phòng ban này không?
                                    <div id="errorMessage-@item.DepartmentId" class="text-danger mt-2"></div>
                                </div>
                                <div class="modal-footer d-flex justify-content-between">
                                    <button type="button" class="btn btn-info" data-bs-dismiss="modal"><i class="bi bi-arrow-left"></i> Hủy</button>
                                    <form id="deleteForm-@item.DepartmentId" asp-action="Delete" asp-route-id="@item.DepartmentId" method="post">
                                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Xóa</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>                   
                }
            </tbody>
        </table>
    </div>
    <!-- Phân trang -->
    <div class="d-flex justify-content-center my-4">
        <ul class="pagination">
            @if (ViewData["CurrentPage"] != null && (int)ViewData["CurrentPage"]! > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new { page = 1 })">Đầu</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["CurrentPage"]! - 1 })">Trước</a>
                </li>
            }

            @if ((int)ViewData["TotalPages"]! > 1)
            {
                int totalPages = (int)ViewData["TotalPages"]!;
                for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == (int)ViewData["CurrentPage"]! ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                    </li>
                }
            }

            @if (ViewData["CurrentPage"] != null && (int)ViewData["CurrentPage"]! < (int)ViewData["TotalPages"]!)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["CurrentPage"]! + 1 })">Sau</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new { page = (int)ViewData["TotalPages"]! })">Cuối</a>
                </li>
            }
        </ul>
    </div>
    <!-- Modal Create -->
    <div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 class="modal-title" id="createModalLabel">Tạo mới phòng ban</h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="Create" method="post">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="newDepartmentName" class="form-label">Tên phòng ban</label>
                            <input type="text" id="newDepartmentName" name="DepartmentName" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label for="newStatus" class="form-label">Trạng thái</label>
                            <select id="newStatus" name="Status" class="form-select" required>
                                <option value="1">Hoạt động</option>
                                <option value="0">Tạm dừng</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <button type="button" class="btn btn-danger" data-bs-dismiss="modal"><i class="bi bi-arrow-left"></i> Quay lại</button>
                        <button type="submit" class="btn btn-warning"><i class="bi bi-plus-circle"></i> Tạo mới</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>

<script>
    // Hàm xử lý xóa phòng ban
    function deleteDepartment(departmentId) {
        const form = document.querySelector(`#deleteForm-${departmentId}`);

        fetch(form.action, {
            method: 'POST',
            body: new FormData(form)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Nếu xóa thành công, đóng modal và làm mới danh sách
                window.location.reload();
            } else {
                // Nếu có lỗi, hiển thị thông báo trong modal
                document.getElementById(`errorMessage-${departmentId}`).innerText = data.message;
            }
        })
        .catch(error => {
            console.error('Error:', error);
        });
    }
</script>
