@model admin_sweetsoft_tech_support.Models.TblDepartment

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <title>Edit</title>
    <style>
        .title {
            color: #6a1b9a;
            padding: 15px;
            text-align: center;
            font-size: 34px;
            font-weight: bold;
        }

        .tab-container {
            max-width: 800px;
            margin: 0 auto;
            background-color: #fff;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
        }

        .nav-tabs {
            display: flex;
            border-bottom: 1px solid #ddd;
            margin-bottom: 20px;
        }

            .nav-tabs .nav-link {
                padding: 10px 15px;
                text-decoration: none;
                color: #6a1b9a;
                font-weight: bold;
                cursor: pointer;
                border: 1px solid transparent;
                border-radius: 5px 5px 0 0;
                margin-right: 5px;
            }

                .nav-tabs .nav-link.active {
                    background-color: #6a1b9a;
                    color: #fff;
                    border-color: #6a1b9a #6a1b9a #fff;
                }

        .tab-content {
            display: none;
        }

            .tab-content.active {
                display: block;
            }

        .form-group {
            margin-bottom: 15px;
        }

            .form-group label {
                font-weight: bold;
                display: block;
                margin-bottom: 5px;
            }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

            table th, table td {
                border: 1px solid #ddd;
                padding: 10px;
                text-align: left;
            }

            table th {
                background-color: #f4f4f4;
            }
    </style>
</head>
<body>
    <div class="title">CHỈNH SỬA PHÒNG BAN</div>
    <div class="tab-container">
        <div class="nav-tabs">
            <a class="nav-link active" onclick="showTab(event, 'tab1')">Thông tin cơ bản</a>
            <a class="nav-link" onclick="showTab(event, 'tab2')">Danh sách nhân viên</a>
        </div>

        <!-- Tab 1: Thông tin cơ bản -->
        <div id="tab1" class="tab-content active">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="DepartmentId" />
                <div class="form-group">
                    <label asp-for="DepartmentName" class="control-label">Tên phòng ban</label>
                    <input asp-for="DepartmentName" class="form-control" />
                    <span asp-validation-for="DepartmentName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label">Trạng thái</label>
                    <div>
                        <label>
                            <input type="radio" asp-for="Status" value="1" /> Hoạt động
                        </label>
                        <label>
                            <input type="radio" asp-for="Status" value="0" /> Tạm dừng
                        </label>
                    </div>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-between">                   
                    <a asp-action="Index" class="btn btn-outline-danger"><i class="bi bi-arrow-left"></i> Quay lại</a>
                    <button class="btn btn-outline-primary" type="submit"><i class="bi bi-check"></i> Lưu</button>
                </div>
            </form>
        </div>

        <!-- Tab 2: Danh sách nhân viên -->
        <div id="tab2" class="tab-content">
            <h4>Danh sách nhân viên thuộc phòng ban: @((ViewData["Department"] as admin_sweetsoft_tech_support.Models.TblDepartment).DepartmentName)</h4>
            <form asp-action="create" asp-controller="TblUsers" method="get">
                <button class="create-btn btn btn-outline-info btn-sm">
                    <i class="bi bi-plus-circle"></i>
                    <span class="d-lg-inline-block d-none">
                        Thêm NV
                    </span>
                </button>
            </form>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Tên nhân viên</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Trạng thái</th>
                            <th>Chức vụ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var users in Model.TblUsers)
                        {
                            <tr>
                                <td>@users.FullName</td>
                                <td>@users.Email</td>
                                <td>@users.Phone</td>
                                <td>@(users.Status == 1 ? "Hoạt động" : "Tạm dừng")</td>
                                <td>@users.Role?.RoleName</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <!-- Phân trang: Chỉ hiển thị khi có nhiều hơn 1 trang -->
                @if (ViewData["TotalUsers"] != null)
                {
                    var totalUsers = (int)ViewData["TotalUsers"]!;
                    var totalPages = (int)Math.Ceiling(totalUsers / 6.0); // Tổng số trang
                    var currentPage = (int)ViewData["CurrentPage"]!;

                    if (totalPages > 1)  // Chỉ hiển thị phân trang khi tổng số trang > 1
                    {
                        <nav>
                            <ul class="pagination justify-content-center">
                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Edit", new { id = (ViewData["Department"] as admin_sweetsoft_tech_support.Models.TblDepartment).DepartmentId, page = i })">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                }
            </div>
            <div class="d-flex justify-content-between mt-3">
                <a asp-action="Index" class="btn btn-outline-danger"><i class="bi bi-arrow-left"></i> Quay lại</a>
                <a class="btn btn-success" asp-action="ExportToExcel" asp-route-id="@Model.DepartmentId" asp-controller="TblDepartments">
                    <i class="bi bi-file-earmark-excel"></i> Xuất file
                </a>
            </div>
        </div>
    </div>
</body>
</html>
<script>
    function showTab(event, tabId) {
        const tabs = document.querySelectorAll('.tab-content');
        const links = document.querySelectorAll('.nav-link');
        tabs.forEach(tab => tab.classList.remove('active'));
        links.forEach(link => link.classList.remove('active'));
        document.getElementById(tabId).classList.add('active');
        event.currentTarget.classList.add('active');
    }
</script>
